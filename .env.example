# ─── Database ────────────────────────────────────────────
# Docker Compose 사용 시 docker-compose.yml의 POSTGRES_PASSWORD와 일치시킬 것
DATABASE_URL="postgresql://omnis:CHANGE_ME@localhost:5432/omnis"
# Prisma direct connection URL. 로컬 Docker에서는 DATABASE_URL과 같게 둬도 됩니다.
POSTGRES_URL_NON_POOLING="postgresql://omnis:CHANGE_ME@localhost:5432/omnis"

# ─── NextAuth ────────────────────────────────────────────
# 비밀키 생성: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Gemini API ──────────────────────────────────────────
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=""

# ─── Seed / E2E ──────────────────────────────────────────
# 시드 사용자 5명에 적용될 공통 비밀번호 (개발용)
SEED_PASSWORD="changeme"
# Playwright E2E 로그인 시 사용
E2E_PASSWORD="changeme"

# ── 화면 오류 알림 메일 ──────────────────────────────
# 셋 다 있어야 메일이 나간다. 없으면 오류는 Vercel 함수 로그에만 남는다.
# Resend(https://resend.com) 대시보드에서 API 키를 만들고, 보내는 도메인을 인증한다.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
