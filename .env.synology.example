# docker-compose.synology.yml과 함께 사용. NAS의 같은 폴더에 .env로 저장.
# 모든 값은 따옴표 없이 = 뒤에 바로 입력합니다.

# ─── PostgreSQL ──────────────────────────────────────────
# 임의의 강한 비밀번호 (영문 + 숫자 + 특수문자, 20자 이상 권장)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# ─── 공개 포트 ───────────────────────────────────────────
# NAS에서 Omnis가 열 포트. 다른 서비스가 3000번을 이미 쓰고 있으면
# 3100, 3200 등 비어 있는 값으로 바꾼다. (아래 NEXTAUTH_URL의 포트도 같이 변경)
OMNIS_PORT=3000

# ─── NextAuth ────────────────────────────────────────────
# 비밀키 생성: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32
# 사내 LAN에서만 사용: http://<NAS내부IP>:<OMNIS_PORT>
# 외부에서 접속하려면 도메인/리버스 프록시 주소
NEXTAUTH_URL=http://192.168.0.10:3000

# ─── Gemini API ──────────────────────────────────────────
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=

# ─── 시드 계정 비밀번호 ──────────────────────────────
# 테스트 계정 user001~user005 의 공통 비밀번호
SEED_PASSWORD=haddscience1234!
# 관리자(admin) 계정 비밀번호 — 강하게 설정할 것. 설치 후 변경 권장.
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
