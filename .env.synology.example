# docker-compose.synology.yml과 함께 사용. NAS의 같은 폴더에 .env로 저장.
# 모든 값은 따옴표 없이 = 뒤에 바로 입력합니다.

# ─── PostgreSQL ──────────────────────────────────────────
# 임의의 강한 비밀번호 (영문 + 숫자 + 특수문자, 20자 이상 권장)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD

# ─── NextAuth ────────────────────────────────────────────
# 비밀키 생성: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32
# 사내 LAN에서만 사용: http://<NAS내부IP>:3000
# 외부에서 접속하려면 도메인/리버스 프록시 주소
NEXTAUTH_URL=http://192.168.0.10:3000

# ─── Gemini API ──────────────────────────────────────────
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=

# ─── 시드 사용자 비밀번호 ──────────────────────────────
# 최초 1회 prisma seed로 생성되는 5명 계정의 공통 비밀번호
SEED_PASSWORD=hadd1234
