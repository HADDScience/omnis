generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── 사용자 ──────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  name                  String    @unique
  email                 String?
  position              String? // 직급 (예: 대표, 상무, 팀장, 과장, 사원)
  department            String? // 부서 (예: 연구개발팀, AI개발팀)
  role                  Role      @default(MEMBER)
  passwordHash          String
  isActive              Boolean   @default(true)
  onboardingVideoSeenAt DateTime?
  onboardingCompletedAt DateTime?
  /// 마지막으로 마치거나 건너뛴 안내 판(lib/onboarding-version.ts). 비어 있으면 마친 시각이 있을 때 1판으로 본다
  onboardingVersion     Int?
  workspaceLayout       Json?
  createdAt             DateTime  @default(now())

  assignedTasks         TaskAssignee[]
  instructedTasks       Task[]                @relation("TaskInstructor")
  chatMessages          ChatMessage[]
  chatRoomsCreated      ChatRoom[]            @relation("ChatRoomCreator")
  chatRoomMembers       ChatRoomMember[]
  chatRoomPrefs         ChatRoomPref[]
  chatFolders           ChatFolder[]
  weeklyReports         WeeklyReport[]
  omnisUpdates          OmnisCard[]
  omnisVersions         OmnisCardVersion[]
  cardDecisions         CardProposal[]
  recordDecisions       RecordProposal[]      @relation("RecordProposalDecider")
  omnisQueries          OmnisQuery[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  notificationPref      NotificationPref?
  pushPresence          PushPresence?
  uiEvents              UiEvent[]
  uiSurveyResponses     UiSurveyResponse[]
  featureRequestEntries FeatureRequestEntry[]
  omnisViewLogs         OmnisViewLog[]
  bookmarks             Bookmark[]
  activityLogs          ActivityLog[]
  geminiUsages          GeminiUsage[]
  identities            UserIdentity[]
  aiDraftRevisions      AiDraftRevision[]
  staffProfile          StaffProfile?
  grantDecisionOwners   GrantDecisionOwner[]
}

enum Role {
  ADMIN
  MEMBER
}

// ─── 채팅 ────────────────────────────────────────────────

/// 자체 계정(User)에 얹는 소셜 로그인 수단.
///
/// 계정의 주인은 언제나 User 다. 소셜은 "그 계정으로 들어오는 또 하나의 문"일 뿐이라,
/// 제공자가 서비스를 접거나 회사가 도구를 바꿔도 계정과 업무 데이터는 그대로 남는다.
///
/// 소셜 이메일로 사람을 짐작해 묶지 않는다 — 개인 지메일·카카오 이메일은 회사 계정과
/// 다르고, 카카오는 이메일 제공이 선택 동의라 아예 없을 수도 있다. 대신 **이미 로그인해
/// 계정 소유를 증명한 세션**에서만 연결을 허용한다. 남의 계정에 붙이려면 그 사람의
/// 세션이 필요하므로 원리적으로 막힌다.
model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google" | "kakao"
  provider          String
  /// 제공자가 발급한 불변 식별자 (구글 sub, 카카오 회원번호)
  providerAccountId String
  /// 화면에 "어느 계정과 연결됐는지" 보여주기 위한 참고값. 매칭에는 쓰지 않는다.
  email             String?
  createdAt         DateTime @default(now())

  /// 한 소셜 계정은 한 사람에게만 붙는다
  @@unique([provider, providerAccountId])
  /// 한 사람이 같은 제공자를 두 번 붙일 수 없다
  @@unique([userId, provider])
  @@index([userId])
}

/// 채팅방. 메신저 왼쪽 목록의 한 줄이다(mydocs/plans/2026-10-28-omnis-messenger-agent.md).
///
/// 업무방(TASK)은 표로 만들지 않는다 — 업무 스레드는 `ChatMessage.taskId` 로 묶인 글이고, 목록은 그 글을 방처럼 보여 준다.
/// enum 에 TASK 가 있는 것은 목록 · 주소가 방 종류를 한 가지 이름으로 부르게 하려는 자리다.
model ChatRoom {
  id            String           @id @default(uuid())
  name          String
  createdAt     DateTime         @default(now())
  /// 기존 방(「전체」 = default-room)은 기본값으로 COMPANY 가 된다. 옛 코드가 kind 없이 upsert 해도 COMPANY 다.
  kind          ChatRoomKind     @default(COMPANY)
  /// 방을 만든 사람. 기존 방 · 카톡 이식 방은 null
  createdById   String?
  createdBy     User?            @relation("ChatRoomCreator", fields: [createdById], references: [id])
  /// 목록 정렬용 — 이 방에 마지막 글이 붙은 시각. 메신저 경로(lib/chat-rooms.ts)가 쓴다.
  /// 전사방은 여러 경로(업무 생성 · MCP · 채팅 패널)가 글을 써서 이 칸을 믿지 않고 최신 글을 직접 읽는다.
  lastMessageAt DateTime?
  /// 사람끼리 1:1(DM) 방만 — 두 사람 id 를 정렬해 이은 값(lib/chat-people-rules.ts dmKeyOf).
  /// 같은 두 사람의 1:1 방이 하나뿐이게 DB 가 막는다(동시에 두 번 눌러도 하나만 생긴다)
  dmKey         String?          @unique
  /// 옴니스 세션(OMNIS_DM)을 사람 방(GROUP · DM)의 @옴니스 언급으로 시작했으면 그 방(2026-11-10).
  /// 세션의 참여자는 이 방의 참여자와 같게 맞춘다 — 초대 · 나가기 때 함께 바뀐다(lib/omnis-mention.ts).
  /// 그래서 방 권한 · 목록 · 검색 · 첨부 · MCP 가 참여자 조건 그대로 공유 세션에도 맞는다. null 이면 개인 세션
  originRoomId  String?
  originRoom    ChatRoom?        @relation("SessionOrigin", fields: [originRoomId], references: [id], onDelete: SetNull)
  sessions      ChatRoom[]       @relation("SessionOrigin")
  messages      ChatMessage[]
  members       ChatRoomMember[]

  @@index([kind, lastMessageAt])
  @@index([originRoomId])
}

enum ChatRoomKind {
  /// 전사방 — 구성원 모두가 읽고 쓴다. 참여자 행이 없어도 된다
  COMPANY
  /// 업무방 — 표로 만들지 않는다(위 주석)
  TASK
  /// 옴니스와의 1:1 방. ChatGPT 의 세션 하나. 참여자는 만든 사람 한 명이다
  OMNIS_DM
  /// 사람끼리 단톡방 — 구성원 누구나 만든다. 초대 · 나가기가 있다. 옴니스는 들어가지 않는다
  GROUP
  /// 사람끼리 1:1 — 두 사람만. 초대 · 나가기가 없고 dmKey 로 같은 두 사람의 방이 하나뿐이다
  DM
}

/// 방 참여자. COMPANY 는 모두가 참여자라 행을 만들지 않는다 — OMNIS_DM · GROUP · DM 은 이 표로 읽기 권한을 정한다.
model ChatRoomMember {
  roomId     String
  room       ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime          @default(now())
  /// 마지막으로 이 방을 연 시각. 안 읽은 글 표시가 쓴다
  lastReadAt DateTime?
  /// 옴니스 세션(OMNIS_DM)에 공유로 들어온 길(2026-11-11). null 이면 세션 주인(만든 사람 · 인계받은 사람)이거나 세션이 아닌 방의 참여자.
  /// PERSON = 주인이 사람을 골라 공유, ROOM = 방에 공유(originRoomId — 그 방 참여자와 같게 맞춘다). 방 동기화는 ROOM 행만 넣고 뺀다(lib/omnis-session-share.ts)
  shareKind  SessionShareKind?

  @@id([roomId, userId])
  @@index([userId])
}

enum SessionShareKind {
  PERSON
  ROOM
}

/// 방 하나에 대한 내 설정 — 즐겨찾기 · 마지막으로 읽은 시각. 메신저 목록(lib/chat-prefs.ts)이 쓴다.
/// 방을 id 가 아니라 방 키로 가리킨다: `room:<ChatRoom.id>` · `task:<Task.id>`.
/// 전사방은 참여자 행이 없고 업무방은 표 자체가 없어(taskId 로 묶인 가상 방) ChatRoomMember 에 달 수 없다.
/// 키 `*` 한 줄은 「안 읽음을 세기 시작한 시각」이다 — 한 번도 열지 않은 방은 그 뒤 글만 센다.
model ChatRoomPref {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomKey    String
  favorite   Boolean   @default(false)
  lastReadAt DateTime?
  /// 내 목록에서 지운 · 숨긴 시각(2026-10-29). 옴니스 1:1 = 대화 삭제(나에게서 숨김 · AgentRun · AiUsage 는 남는다),
  /// 사람 1:1 = 숨기기(이 시각 뒤에 새 글이 오면 다시 보인다). 단톡방은 나가기(참여자 행 삭제)라 쓰지 않는다
  hiddenAt   DateTime?
  /// 이 방의 채팅 푸시를 끈다(2026-10-29). 멘션 푸시와 벨 기록은 그대로 — mydocs/plans/2026-10-29-push-notifications.md
  muted      Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@id([userId, roomKey])
}

/// 추천(규칙) 폴더의 규칙 — 규칙으로만 채우고 방을 손으로 넣지 않는다.
/// MY_TASKS 내가 담당이거나 지시한 업무의 업무방(업무 탭 i-own · i-assigned 와 같은 기준)
/// PROJECT  한 프로젝트의 업무방(ChatFolder.projectId)
/// COMPANY · TASK · GROUP 은 처음 둔 추천 폴더(방 종류로 채웠다). 개념을 바꾸며 쓰지 않는다 —
/// 하나뿐인 방(전사방)은 폴더가 될 수 없다(2026-10-29 작업지시자). 값과 행은 남기고 화면 · API 가 숨긴다
enum ChatFolderRule {
  COMPANY
  TASK
  GROUP
  MY_TASKS
  PROJECT
}

/// 내 채팅방 폴더. 남에게 보이지 않는다. rule 이 있으면 규칙 폴더(방을 직접 담지 않는다), 없으면 수동 폴더
model ChatFolder {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  rule      ChatFolderRule?
  /// rule = PROJECT 일 때 그 프로젝트. 프로젝트 행이 지워지면 null 이 되고 폴더는 남는다(빈 폴더 — 사용자가 지운다)
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// 칩 순서. 작은 것이 앞
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rooms     ChatFolderRoom[]

  /// 프로젝트 폴더는 사람마다 프로젝트별로 하나. NULL 은 서로 겹치지 않아 수동 폴더 · MY_TASKS 는 걸리지 않는다 —
  /// MY_TASKS 하나는 lib/chat-prefs.ts 가 지킨다. 처음의 (userId, rule) 유일 제약은 프로젝트 폴더를 둘 이상 못 만들어 바꿨다
  @@unique([userId, rule, projectId])
  @@index([userId, order])
}

/// 수동 폴더에 넣은 방. 방 키는 ChatRoomPref 와 같다
model ChatFolderRoom {
  folderId String
  folder   ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  roomKey  String
  addedAt  DateTime   @default(now())

  @@id([folderId, roomKey])
}

model ChatMessage {
  id                String           @id @default(uuid())
  /// 외부에서 들여온 원본 식별자. 카톡 이식은 "kakao:<sha1>" 형태.
  /// 이식을 여러 번 돌려도 중복이 생기지 않게 하는 유일한 장치다.
  sourceId          String?          @unique
  roomId            String
  room              ChatRoom         @relation(fields: [roomId], references: [id])
  authorId          String
  author            User             @relation(fields: [authorId], references: [id])
  content           String
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id])
  isTaskInstruction Boolean          @default(false)
  kind              MessageKind      @default(NORMAL)
  createdAt         DateTime         @default(now())
  /// 고친 시각. null 이면 보낸 그대로다.
  editedAt          DateTime?
  /// 지운 시각. 행은 지우지 않는다 — 답장이 가리키는 글 · 업무 연결 · 색인이 함께 사라지기 때문이다.
  /// 본문은 그대로 두고 API 가 내려보내지 않는다.
  deletedAt         DateTime?
  /// 만든 뒤 화면에 보이는 것이 바뀐 시각 — 고치기 · 지우기(2026-10-30).
  /// 폴링은 새 글만 가져와서, 이것이 없으면 남이 고치거나 지운 글이 내 화면에 옛 모습으로 남는다.
  /// null 이면 보낸 그대로다. 백필하지 않는다(지금까지 바뀐 글은 이미 각 화면이 처음 읽을 때 받았다)
  changedAt         DateTime?
  /// 화면이 보낼 때 만든 id. 응답만 끊긴 글을 다시 보내도 두 번 저장되지 않게 한다(2026-10-30).
  /// 화면 밖(MCP · 카톡 이식 · 시스템 글)은 비워 둔다
  clientId          String?          @unique
  /// 답장 대상. 지워진 글에도 답장이 달려 있을 수 있어 행을 남긴다.
  replyToId         String?
  replyTo           ChatMessage?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies           ChatMessage[]    @relation("MessageReply")
  /// 옴니스 답이면 그 답을 만든 질문 기록. 출처(sources)는 OmnisQuery 에 있어 여기 다시 싣지 않는다.
  /// 옴니스 글의 작성자는 시스템 계정(lib/system-user.ts, id "system")이다
  omnisQueryId      String?          @unique
  omnisQuery        OmnisQuery?      @relation(fields: [omnisQueryId], references: [id])
  /// 옴니스 계정이 없는 사람의 글(카톡 이식 · 참여자 전용 방만). 이때 authorId 는 시스템 계정이다 — lib/external-speaker.ts
  externalSpeakerId String?
  externalSpeaker   ExternalSpeaker? @relation(fields: [externalSpeakerId], references: [id], onDelete: Restrict)
  /// 사람 방에 남긴 옴니스 세션 안내(시작 · 완료 줄)가 가리키는 세션 방(OMNIS_DM) id. 누르면 그 세션으로 간다.
  /// 관계를 두지 않는다 — ChatMessage ↔ ChatRoom 에 관계가 둘이 되면 기존 관계에도 이름을 붙여야 한다
  sessionRoomId     String?

  files     File[]
  mentions  ChatMention[]
  revisions ChatMessageRevision[]

  @@index([roomId, createdAt])
  @@index([roomId, changedAt])
  @@index([taskId])
  @@index([replyToId])
  @@index([externalSpeakerId])
}

enum MessageKind {
  NORMAL
  TASK_CREATED
  TASK_REBUILT
  TASK_DONE
  /// 완료로 보이지만 담당자 확인을 기다리는 상태. TASK_DONE 과 구분해야
  /// 활동 요약에 "완료"라고 잘못 적히지 않는다.
  TASK_DONE_PENDING
}

/// 고치기 전 본문(2026-11-17). 고칠 때마다 한 줄 — 관리자 감사용이고 화면 · API 로 내려보내지 않는다.
/// 지금 본문은 ChatMessage.content 다. 가장 오래된 줄이 처음 보낸 원문이다
model ChatMessageRevision {
  id         String      @id @default(uuid())
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// 고치기 전 본문
  content    String
  /// 고친 사람 — 지금은 글쓴이 본인만 고친다. User 관계는 두지 않는다(User 모델을 넓히지 않으려고)
  editedById String
  /// 이 본문이 바뀐 시각
  createdAt  DateTime    @default(now())

  @@index([messageId, createdAt])
}

model ChatMention {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MentionType
  taskId    String?
  userId    String?
  createdAt DateTime    @default(now())

  @@index([type, taskId])
  @@index([type, userId])
  @@index([messageId])
}

enum MentionType {
  TASK
  USER
}

// ─── 업무 ────────────────────────────────────────────────

model Task {
  id             String         @id @default(uuid())
  /// 외부에서 들여온 원본 식별자. 카톡 이식은 "kakao-session:<세션id>" 형태.
  sourceId       String?        @unique
  name           String
  slug           String         @unique
  /// 담당자. 한 업무를 여러 명이 함께 맡을 수 있다 (예: "인턴들 각자 ~해주세요").
  assignees      TaskAssignee[]
  instructorId   String
  instructor     User           @relation("TaskInstructor", fields: [instructorId], references: [id])
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  /// @deprecated 2026-05-06 (Phase 2 #12) — UI/AI에서 제거됨. Phase 4에 컬럼 drop 예정.
  categoryId     String?
  /// @deprecated Phase 2 #12 — Phase 4에 관계 drop 예정.
  category       TaskCategory?  @relation(fields: [categoryId], references: [id])
  status         TaskStatus     @default(TODO)
  priority       Priority       @default(NORMAL)
  background     String?
  expectedResult String?
  deadline       DateTime?
  workStart      DateTime?
  workEnd        DateTime?
  archived       Boolean        @default(false)
  notionId       String?
  sourceMessages Json?

  checklists      Checklist[]
  messages        ChatMessage[]
  files           File[]
  cardProposals   CardProposal[]
  recordProposals RecordProposal[]
  grantDecisions  GrantDecision[]
  events          TaskEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([productId])
  @@index([categoryId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

// ─── 체크리스트 ──────────────────────────────────────────

/// 업무 담당자 (다대다).
///
/// 카톡 이력을 보면 "인턴들 각자 증명사진 보내주세요"처럼 한 번의 지시가 여러 명에게
/// 향하는 경우가 흔하다. 담당자를 하나만 담으면 이런 지시를 업무로 만들 수 없거나,
/// 사람 수만큼 카드를 쪼개 실제보다 지시가 많았던 것처럼 왜곡된다.
///
/// 체크리스트는 사람별로 나누지 않는다. 지시 하나에 목록 하나여야 지시한 사람도
/// 받은 사람도 무엇이 남았는지 같은 화면에서 본다.
model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model Checklist {
  id        String   @id @default(uuid())
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  done      Boolean  @default(false)
  memo      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─── 제품 ────────────────────────────────────────────────

model Product {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String
  sortOrder Int       @default(0)
  projects  Project[]
  tasks     Task[]
}

// ─── 업무 카테고리 (업무 유형) ────────────────────────────
// @deprecated Phase 2 #12 (2026-05-06) — UI/AI에서 폐기됨. Phase 4에 모델 drop 예정.
// 사용자 결정 Q1=A: "이유 없으면 지우자". 다수결로 활용 안이 채택됐으나 사용자 비전 우선.

model TaskCategory {
  id        String  @id @default(uuid())
  name      String  @unique
  icon      String?
  color     String?
  sortOrder Int     @default(0)
  tasks     Task[]
}

// ─── 프로젝트 ────────────────────────────────────────────

model Project {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("진행 중")
  priority  Priority  @default(NORMAL)
  purpose   String?
  goal      String?
  startDate DateTime?
  deadline  DateTime?
  archived  Boolean   @default(false)
  notionId  String?
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])

  tasks          Task[]
  records        CompanyRecord[]
  /// 이 프로젝트의 업무방을 모은 채팅방 폴더(사람마다)
  chatFolders    ChatFolder[]
  grantDecisions GrantDecision[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
}

// ─── 주간 업무보고 ───────────────────────────────────────

model WeeklyReport {
  id          String    @id @default(uuid())
  title       String
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  weekStart   DateTime
  weekEnd     DateTime
  isoWeek     String
  status      String    @default("작성 중")
  submittedAt DateTime?
  content     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, isoWeek])
  @@index([ownerId, weekStart])
}

// ─── 옴니스 지식 베이스 ──────────────────────────────────

model OmnisCategory {
  id        String         @id @default(uuid())
  name      String         @unique
  icon      String?
  sortOrder Int            @default(0)
  cards     OmnisCard[]
  proposals CardProposal[]
}

model OmnisCard {
  id          String             @id @default(uuid())
  categoryId  String
  category    OmnisCategory      @relation(fields: [categoryId], references: [id])
  title       String
  content     Json
  tags        String[]
  version     Int                @default(1)
  updatedById String?
  updatedBy   User?              @relation(fields: [updatedById], references: [id])
  /// 이 카드의 근거. [{ kind: "task"|"message", id, label }] — AI 가 쓴 내용은 근거 없이 남기지 않는다.
  sourceRefs  Json?
  /// AI 가 마지막으로 반영한 시각. 사람이 고치면 그대로 두고 updatedAt 만 움직인다.
  aiUpdatedAt DateTime?
  versions    OmnisCardVersion[]
  viewLogs    OmnisViewLog[]
  bookmarks   Bookmark[]
  proposals   CardProposal[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId])
}

model OmnisCardVersion {
  id               String         @id @default(uuid())
  cardId           String
  card             OmnisCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content          Json
  version          Int
  restoredFromHash String?
  createdById      String?
  createdBy        User?          @relation(fields: [createdById], references: [id])
  /// 이 판을 누가 썼나. AI 가 쓴 문장을 사람이 쓴 문장과 구분한다 (충돌 시 사람이 이긴다).
  authorKind       CardAuthorKind @default(HUMAN)
  createdAt        DateTime       @default(now())

  @@index([cardId, version])
  @@index([createdById])
}

enum CardAuthorKind {
  HUMAN
  AI
}

enum CardProposalStatus {
  /// 사람의 판단을 기다린다
  PENDING
  /// 사람이 수락해 카드에 반영됐다
  ACCEPTED
  /// 사람이 거절했다
  REJECTED
  /// 수락률이 임계치를 넘어 사람 확인 없이 반영됐다
  AUTO_APPLIED
  /// 같은 카드에 더 새로운 제안이 와서 밀렸다
  SUPERSEDED
}

/// AI 가 만든 지식 카드 갱신 제안.
///
/// 사람이 카드를 직접 쓰는 구조로는 한 번도 채워지지 않았다(카드 0장·조회 0).
/// 그래서 AI 가 업무 중 생긴 변화를 제안으로 올리고, 사람이 수락·거절한다.
/// 수락이 꾸준히 많으면 `shouldAutoApply()` 가 자동 적용으로 넘긴다 — lib/card-proposals.ts.
///
/// 배경: mydocs/plans/2026-09-10-ai-maintained-cards.md
model CardProposal {
  id     String             @id @default(uuid())
  status CardProposalStatus @default(PENDING)

  /// 기존 카드를 고치는 제안이면 그 카드. 새 카드 제안이면 null
  cardId     String?
  /// 카드가 지워져도 제안은 남는다 — 이 표가 수락률의 근거라 판단 기록을 잃으면 안 된다.
  card       OmnisCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /// 새 카드 제안일 때 들어갈 분류
  categoryId String?
  category   OmnisCategory? @relation(fields: [categoryId], references: [id])

  title      String
  /// 제안하는 카드 본문 전체 (CardContent 형태 — 통째로 다시 쓴다, 증분이 아니다)
  content    Json
  /// 왜 이렇게 바꾸는지 한 줄
  reason     String
  /// 근거 [{ kind, id, label }]. 비어 있으면 만들지 않는다
  sourceRefs Json

  /// 무엇이 이 제안을 불렀나 — task_done · weekly · manual · seed
  trigger       String
  triggerTaskId String?
  triggerTask   Task?   @relation(fields: [triggerTaskId], references: [id], onDelete: SetNull)

  decidedById String?
  decidedBy   User?     @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime?
  /// 되돌린 시각. 자동 적용된 것을 사람이 되돌리면 수락률에 거절로 반영된다
  revertedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([cardId])
  @@index([triggerTaskId])
}

// 옴니스 RAG 질문·답변 내역 (사용자별)
model OmnisQuery {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  question  String
  answer    String
  /// 답변 근거 출처 배열 [{ id, source, sourceId, title, sourceLabel, similarity }]
  sources   Json
  createdAt DateTime     @default(now())
  /// 메신저 옴니스 방에서 나온 질문이면 그 답 글
  message   ChatMessage?

  @@index([userId, createdAt])
}

model OmnisViewLog {
  id       String    @id @default(uuid())
  cardId   String
  card     OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?     @relation(fields: [userId], references: [id])
  viewedAt DateTime  @default(now())

  @@index([cardId, viewedAt])
  @@index([userId, viewedAt])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, cardId])
  @@index([userId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// ─── 파일 ────────────────────────────────────────────────

/// 옴니스 계정이 없는 카톡 발화자. 이름 · 소속 · 직급만 저장한다 — 로그인 · 멘션 · 담당 · 알림 대상이 아니다.
model ExternalSpeaker {
  id       String        @id
  name     String
  org      String?
  title    String?
  messages ChatMessage[]
}

model File {
  id              String        @id @default(uuid())
  name            String
  path            String
  size            Int
  mimeType        String
  messageId       String?
  message         ChatMessage?  @relation(fields: [messageId], references: [id])
  taskId          String?
  task            Task?         @relation(fields: [taskId], references: [id])
  createdAt       DateTime      @default(now())
  /// 사진 설명 — 검색 색인(EmbeddingSource.PHOTO)에 들어가는 글. 이미지가 아니거나 아직 안 만들었으면 null.
  /// 사진 안의 내용으로 찾게 하려고 둔다(mydocs/plans/2026-10-29-photo-search.md)
  description     String?       @db.Text
  describedAt     DateTime?
  /// 만든 모델 — "openai:gpt-6.1-terra" (앱 업로드) · "claude-cli:sonnet" (카톡 이식 · 일괄)
  describedBy     String?
  /// 참여자만 보는 방(옴니스 1:1 · 사람 1:1 · 단톡방)에 붙이려고 올린 파일이면 올린 사람 id. 전사방 · 업무 첨부는 null.
  /// 메시지에 붙기 전에는 올린 사람만, 붙은 뒤에는 그 방 참여자만 본다 — 판정은 lib/file-access.ts 한 곳.
  /// User 관계를 두지 않는다(AgentRun.userId 와 같은 이유 — 사람이 바뀌어도 행은 남는다)
  privateToUserId String?
  /// 큰 첨부(4MB 초과)를 임시 저장소에서 NAS 로 옮기는 상태. 행이 없으면 지금처럼 NAS 파일이다
  transfer        FileTransfer?
  /// R2(S3 호환)에 올린 큰 첨부. 행이 있으면 실물은 R2 에 있고 열람은 서명 주소로 간다(mydocs/manual/r2-upload.md)
  r2Object        FileR2Object?

  @@index([privateToUserId])
}

/// 큰 첨부의 임시본 → NAS 복사. 설계: mydocs/plans/2026-11-04-large-upload.md
/// VERIFIED 전에는 임시본이 하나뿐인 원본이다 — 지우는 곳은 lib/large-upload/steps.ts 의 deleteTemp 하나뿐이다.
enum FileTransferState {
  UPLOADED
  COPYING
  WAITING_NAS
  VERIFIED
  TEMP_DELETED
  FAILED
}

model FileTransfer {
  fileId         String            @id
  file           File              @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// 임시 저장소의 경로. 파일 이름을 넣지 않는다
  blobPathname   String
  state          FileTransferState @default(UPLOADED)
  segmentSize    Int
  segmentsDone   Int               @default(0)
  /// 조각 해시를 차례로 이은 sha256. 감사용
  manifestSha256 String?
  /// 크론이 다시 시작한 횟수
  attempts       Int               @default(0)
  lastError      String?
  notifiedAt     DateTime?
  uploadedAt     DateTime          @default(now())
  verifiedAt     DateTime?
  blobDeletedAt  DateTime?
  updatedAt      DateTime          @updatedAt
  /// 지금 도는 Workflow 실행. 크론이 다시 시작할 때 옛 실행을 멈추는 데 쓴다
  runId          String?

  @@index([state, updatedAt])
  @@index([uploadedAt])
}

/// R2 에 올린 큰 첨부의 기록. 다 올라가 합쳐진 뒤에만 만든다 — 올리는 중인 것은 서명된 세션 표가 들고 있다.
/// 올리다 버린 조각은 버킷 수명 규칙(미완료 멀티파트 중단)이 지운다
model FileR2Object {
  fileId     String   @id
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  bucket     String
  /// 저장 키. 파일 이름을 넣지 않는다(uploads/{fileId}/{fileId})
  key        String
  /// 합친 뒤 R2 가 준 ETag — 감사용
  etag       String?
  partBytes  Int
  partCount  Int
  uploadedAt DateTime @default(now())

  @@index([uploadedAt])
}

// ─── Gemini 토큰 사용 로그 ───────────────────────────────

model GeminiUsage {
  id              String   @id @default(uuid())
  endpoint        String
  promptTokens    Int
  candidateTokens Int
  totalTokens     Int
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── 알림 ────────────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  title      String
  content    String?
  entityId   String?
  read       Boolean   @default(false)
  /// 사용자의 명시적 응답이 필요한 알림의 종류. null이면 단순 통보.
  /// 값은 lib/schemas/notification.ts 의 NotificationActionSchema 와 일치해야 한다.
  actionType String?
  /// 액션에 응답한 시각. actionType != null && resolvedAt == null 이면 미해결 —
  /// 응답 전까지 삭제되지 않고 목록에 남는다.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, actionType, resolvedAt])
}

/// 웹 푸시 구독 — 탭이 닫혀 있어도 알림이 가게 하는 통로.
///
/// 사람이 아니라 **기기(브라우저)마다 하나**다. 한 사람이 휴대폰과 노트북에서 따로 구독하고,
/// 같은 기기라도 브라우저가 다르면 다른 구독이다. 그래서 userId 는 유일하지 않다.
///
/// endpoint 는 푸시 서비스(FCM · Mozilla · Apple)가 준 주소이고 그 자체가 식별자다.
/// 브라우저가 구독을 갱신하면 endpoint 가 바뀌어 같은 기기가 행을 여럿 남길 수 있다 —
/// 죽은 것은 발송이 404/410 을 받을 때 지운다 (lib/push.ts).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  /// 브라우저가 준 공개키와 인증 비밀. 이것으로 본문을 암호화한다.
  p256dh    String
  auth      String
  /// 어느 기기인지 사람이 알아보라고 남긴다. 목록에서 "이 기기"를 가리기 위한 참고값
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// 사람이 지금 Omnis 를 쓰고 있는 기기(2026-10-30). 사람마다 한 줄, 화면을 만질 때 덮어쓴다.
/// activeAt 이 최근이면 푸시를 이 기기로만 보낸다 — PC 에서 쓰는 중에 폰이 울리지 않게.
/// 규칙의 정본은 lib/notify-rules.ts presenceTargets 다.
model PushPresence {
  userId   String   @id
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeAt DateTime
  /// 그 기기의 푸시 구독 endpoint. 구독하지 않은 기기면 null — 그때는 어느 기기로도 보내지 않는다
  endpoint String?
}

/// 사람마다 종류별 기기 알림(푸시) 켜고 끄기(2026-10-29). 행이 없으면 전부 켜짐이다.
/// 끄면 그 종류의 **푸시만** 멈춘다 — 벨(Notification) 기록은 그대로 남아 놓치지 않는다.
/// 종류 나눔은 lib/notify-rules.ts categoryOfType 이 정본이다.
model NotificationPref {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 채팅 글 · 옴니스 답 · 확인 카드 · chat_mention
  chatPush     Boolean  @default(true)
  /// task_* (지정 · 완료 확인 · 재구성 · 상태 변경 · 수락)
  taskPush     Boolean  @default(true)
  /// calendar_event_added
  calendarPush Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// ─── 임베딩 (pgvector 벡터 검색) ─────────────────────────
// 옴니스 카드·업무·주간보고·채팅을 청크 단위로 임베딩해 RAG 검색에 사용.
// embedding 컬럼은 Prisma 미지원 타입이라 raw SQL(lib/embeddings.ts)로 read/write.

enum EmbeddingSource {
  OMNIS_CARD
  TASK
  WEEKLY_REPORT
  CHAT_MESSAGE
  /// 지식재산권 건 (상표·특허). sourceId 는 "trademark:TM-01" 꼴.
  IP_CASE
  /// 사진 설명. sourceId 는 File.id
  PHOTO
}

model EmbeddingChunk {
  id          String                      @id @default(uuid())
  source      EmbeddingSource
  sourceId    String
  chunkIndex  Int                         @default(0)
  title       String
  content     String
  contentHash String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([source, sourceId, chunkIndex])
  @@index([source, sourceId])
}

// ─── SSO (사내 도구 통합 로그인) ─────────────────────────────────────

/// 발급된 SSO grant 의 사용 기록. 1회용을 강제하는 것이 유일한 목적이다.
///
/// jti 를 PK 로 두고 INSERT 를 시도하는 것 자체가 검사다 — 두 번째 INSERT 는
/// 유니크 위반으로 튕긴다. 메모리 캐시로는 서버리스 인스턴스가 여러 개일 때
/// 같은 표가 두 번 통과할 수 있어 DB 로 못박는다.
///
/// 만료된 행은 재사용 판정에 쓸모가 없어 가끔 청소한다 (lib/sso.ts consumeGrant).
model SsoGrant {
  /// 토큰의 jti 클레임
  jti       String   @id
  /// 어느 앱용으로 끊은 표인가 (토큰의 audience)
  appId     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// 업무 초안을 자연어 지시로 고친 기록.
///
/// "담당자는 혜린님으로, 마감은 다음주" 같은 지시와 그 전후 값을 남긴다.
/// 사람이 AI의 어떤 판단을 어떻게 되돌리는지가 쌓이는 자리다.
/// 지금은 **보관만** 한다 — 읽는 화면은 아직 없다.
model AiDraftRevision {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// 초안의 출발점이 된 원문 (슬래시 명령 등). 없을 수 있다.
  source      String?
  /// 사용자가 자연어로 준 수정 지시
  instruction String
  /// 지시 직전의 폼 값 (TaskDraftSnapshotSchema 형태)
  before      Json
  /// AI가 돌려준 결과 (적용 전 원본, TaskAiDraftSchema 형태)
  after       Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── CRM ─────────────────────────────────────────────────
//
// 엑셀 HADDScience_CRM_260527.xlsx 를 대체한다. 모델 이름에 Crm 을 붙이는 이유는
// Product 가 이미 업무 분류용으로 쓰이고 있고, Org·Contact·Quote 는 앞으로도
// 부딪히기 쉬운 이름이기 때문이다.
//
// 엑셀이 문자열(기관명·담당자명)로 시트를 잇던 것을 전부 FK 로 바꿨다. 그래서
// "담당자명에 직함을 쓰지 말라"는 규칙이 사라진다 — 직함은 별도 칸이다.

enum CrmOrgType {
  UNIVERSITY // 대학
  RESEARCH // 연구원
  COMPANY // 기업
  HOSPITAL // 병원
  OTHER
}

enum CrmMembershipStatus {
  ACTIVE // 활성
  INACTIVE // 해지
}

enum CrmQuoteStatus {
  DRAFT // 작성중
  SENT // 발송
  DONE // 완료
  CANCELLED // 취소
}

model CrmOrg {
  id           String     @id @default(uuid())
  code         String     @unique // ORG001 — 엑셀 기관코드를 그대로 이어받는다
  name         String     @unique
  type         CrmOrgType @default(OTHER)
  /// 사업자등록번호 — 세금계산서의 공급받는자를 기관에 잇는 열쇠
  bizRegNo     String?    @unique
  address      String?
  note         String?
  /// 세금계산서를 받는 기관. **비어 있으면 자기 자신이다** — 기존 기관은 전부 비어 있다.
  /// 대학 학과(견적) → 산학협력단(세금계산서)처럼 둘이 다를 때만 채운다. 한 단계만 — 청구처의 청구처는 없다.
  billingOrgId String?
  billingOrg   CrmOrg?    @relation("BillingOrg", fields: [billingOrgId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// 이 기관을 청구처로 둔 기관들
  billedOrgs     CrmOrg[]           @relation("BillingOrg")
  contacts       CrmContact[]
  memberships    CrmMembership[]
  quotes         CrmQuote[]
  sampleRequests CrmSampleRequest[]
  shipments      CrmShipment[]
  taxInvoices    TaxInvoice[]
  inquiries      WebsiteInquiry[]

  @@index([name])
}

model CrmContact {
  id    String  @id @default(uuid())
  code  String  @unique // CT001
  orgId String
  org   CrmOrg  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String
  /// 교수·소장·박사 등. 엑셀에서는 이름에 붙이면 매칭이 깨져 금지했지만 여기서는 별개다.
  title String?
  phone String?
  email String?
  note  String?

  memberships    CrmMembership[]
  quotes         CrmQuote[]
  sampleRequests CrmSampleRequest[]
  inquiries      WebsiteInquiry[]

  @@index([orgId])
  @@index([name])
}

/// HRP Membership. 활성이면 견적에서 할인을 제안한다 — 강제하지는 않는다.
model CrmMembership {
  id             String              @id @default(uuid())
  code           String              @unique // HRP260001
  orgId          String
  org            CrmOrg              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        CrmContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status         CrmMembershipStatus @default(ACTIVE)
  discountAmount Int                 @default(400000)
  createdAt      DateTime            @default(now())

  quotes CrmQuote[]

  @@index([orgId])
}

model CrmProduct {
  id               String       @id @default(uuid())
  code             String       @unique // PRD001
  name             String
  spec             String? // 규격 — 5ml, 1ml, 5g …
  kind             String? // 타입 — 시린지 / 바이알 / 원료 / 세트 …
  /// 기준 단가. 견적에는 이 값이 **복사**되어 굳는다. 여기를 고쳐도 지난 견적은 변하지 않는다.
  unitPrice        Int?
  /// 원료(DNA 등)는 판매 품목이 아니라 재고 대상이다.
  isMaterial       Boolean      @default(false)
  /// 이 품목을 무엇으로 세는가. 원료는 그램, 완제품은 개.
  stockUnit        CrmStockUnit @default(PIECE)
  /// 완제품 한 개의 용량(ml). 생산에 드는 원료량을 계산할 때 쓴다.
  volumeMl         Decimal?     @db.Decimal(10, 3)
  /// 농도(%, g/100ml). 1% = 1ml 당 0.01g.
  /// 애드젤이 1% 다. 모르는 품목은 비워 두고, 비어 있으면 소요량을 계산하지 않는다 —
  /// 숫자를 지어내느니 계산을 안 하는 편이 낫다.
  concentrationPct Decimal?     @db.Decimal(6, 3)
  note             String?
  archived         Boolean      @default(false)
  /// 젤 제품 타입(2026-11-25). 애드젤 · 라이브젤 두 줄에만 있다. 이 줄은 규격별 행이 아니라 타입 하나이고,
  /// 재고는 (타입, 농도 %) 마다 총 ml 로 센다(CrmStockMove.concentrationPct · quantity). 개수는 세지 않는다
  gelType          CrmGelType?  @unique
  /// 규격별 젤 행을 타입으로 옮겼을 때 옮겨 간 타입 제품. 이 행은 숨김(archived)이 되고 지난 기록의 원본으로 남는다
  mergedIntoId     String?

  quoteItems        CrmQuoteItem[]
  sampleRequests    CrmSampleRequest[]
  shipments         CrmShipment[]
  stockMoves        CrmStockMove[]
  productions       CrmProduction[]    @relation("ProducedProduct")
  usedInProductions CrmProduction[]    @relation("ProductionMaterial")
  invoiceItems      TaxInvoiceItem[]

  @@unique([name, spec])
}

model CrmQuote {
  id        String      @id @default(uuid())
  code      String      @unique // HADD240924-001
  quotedAt  DateTime
  orgId     String
  org       CrmOrg      @relation(fields: [orgId], references: [id])
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  membershipId   String?
  membership     CrmMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  /// **실제로 깎인 금액.** 엑셀에는 회원이면 400,000 이 자동으로 적혔지만 13건 중 8건은
  /// 소계에서 빠지지 않았다(단가에 녹인 것으로 보인다). 여기에는 실제 적용액만 담는다.
  discountAmount Int            @default(0)

  vatRate       Int            @default(10) // %
  status        CrmQuoteStatus @default(DRAFT)
  taxInvoicedAt DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items       CrmQuoteItem[]
  shipments   CrmShipment[]
  taxInvoices TaxInvoice[]
  inquiries   WebsiteInquiry[]

  @@index([orgId])
  @@index([quotedAt])
}

model CrmQuoteItem {
  id               String     @id @default(uuid())
  quoteId          String
  quote            CrmQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId        String
  product          CrmProduct @relation(fields: [productId], references: [id])
  quantity         Int
  /// 견적 당시 단가의 사본. 제품 단가가 나중에 바뀌어도 지난 견적 금액은 그대로다.
  unitPrice        Int
  note             String?
  sortOrder        Int        @default(0)
  /// 젤 타입 제품이면 농도(%) · 한 개 용량(ml). quantity 는 그 용량의 개수다(견적은 개수 × 단가로 남긴다)
  concentrationPct Decimal?   @db.Decimal(6, 3)
  volumeMl         Decimal?   @db.Decimal(10, 3)
  /// 규격별 젤 행에서 옮겨 왔으면 원래 제품
  legacyProductId  String?

  @@index([quoteId])
}

// ─── CRM — 샘플요청 · 출고 · 재고 ─────────────────────────

enum CrmSampleStatus {
  PENDING // 미발송
  SENT // 발송완료
}

enum CrmShipmentKind {
  SALE // 판매
  SAMPLE // 샘플
  GIFT // 증정
}

enum CrmShipmentStatus {
  PREPARING // 준비중
  SHIPPING // 배송중
  DELIVERED // 배송완료
}

/// 재고를 세는 단위. 원료는 g, 완제품은 개다.
/// 예전에는 원료도 "DNA 5g 15개" 처럼 개로 셌는데, 5g 병과 4.5g 병이 섞이면
/// 개수만으로는 몇 그램인지 알 수 없다. 생산에 쓰는 것은 그램이다.
enum CrmStockUnit {
  PIECE // 개
  GRAM // g
  ML // ml — 젤 타입. (타입, 농도) 마다 총 ml 로 센다
}

/// 젤 제품 타입. 규격(용량)마다 제품 행을 두지 않고 타입 둘로 고정한다(2026-11-25 결정)
enum CrmGelType {
  ADDGEL // 애드젤 (ADD GEL)
  LIVEGEL // 라이브젤 (LiVEGEL)
}

/// 재고 장부의 방향. 현재고 = Σ IN − Σ OUT 로만 구한다 — 어딘가에 적힌 숫자를
/// 믿지 않는다. 엑셀은 요약 칸을 따로 두고 출고를 "별도 관리" 해서 총 출고량이
/// 23건의 출고 기록이 있는데도 0 으로 남아 있었다.
enum CrmStockDirection {
  IN
  OUT
}

model CrmSampleRequest {
  id               String          @id @default(uuid())
  code             String          @unique // HADD251202-001
  requestedAt      DateTime
  orgId            String
  org              CrmOrg          @relation(fields: [orgId], references: [id])
  contactId        String?
  contact          CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  productId        String?
  product          CrmProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 요청사항 원문. "라이브젤 샘플 및 카다로그 요청" 처럼 제품만으로는 안 담기는 말이 들어온다.
  request          String?
  /// 소개경로 — 학회·지인·QR·전화. 어디서 왔는지가 다음 영업의 단서다.
  referral         String?
  status           CrmSampleStatus @default(PENDING)
  sentAt           DateTime?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// 젤 타입 제품이면 농도(%) · 보낼 ml(총량). 딸린 샘플 출고가 이 값을 따른다
  concentrationPct Decimal?        @db.Decimal(6, 3)
  volumeMl         Decimal?        @db.Decimal(10, 3)
  legacyProductId  String?

  shipments CrmShipment[]
  inquiries WebsiteInquiry[]

  @@index([orgId])
  @@index([requestedAt])
}

model CrmShipment {
  id               String            @id @default(uuid())
  code             String            @unique // SH001
  shippedAt        DateTime
  kind             CrmShipmentKind   @default(SALE)
  orgId            String
  org              CrmOrg            @relation(fields: [orgId], references: [id])
  productId        String
  product          CrmProduct        @relation(fields: [productId], references: [id])
  /// 개수. 젤 타입 출고는 개수를 세지 않아 비어 있고, volumeMl 이 출고 ml 다
  quantity         Int?
  status           CrmShipmentStatus @default(PREPARING)
  /// 어느 견적/샘플요청에서 나온 출고인지. 엑셀은 견적번호를 문자열로 적어 뒀다.
  quoteId          String?
  quote            CrmQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  sampleRequestId  String?
  sampleRequest    CrmSampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// 젤 타입 제품이면 농도(%) · 출고 ml(총량). 재고에서는 그 농도 칸에서 volumeMl 만큼 빠진다
  concentrationPct Decimal?          @db.Decimal(6, 3)
  volumeMl         Decimal?          @db.Decimal(10, 3)
  legacyProductId  String?

  stockMoves CrmStockMove[]

  @@index([orgId])
  @@index([shippedAt])
}

/// 재고 장부 한 줄. 입고도 출고도 같은 표에 쌓는다.
///
/// 단위는 품목이 정한다(CrmProduct.stockUnit) — 원료면 g, 완제품이면 개.
/// 그램은 4.5 처럼 소수가 나오므로 정수로 두면 안 된다.
model CrmStockMove {
  id               String            @id @default(uuid())
  movedAt          DateTime
  productId        String
  product          CrmProduct        @relation(fields: [productId], references: [id])
  direction        CrmStockDirection
  quantity         Decimal           @db.Decimal(12, 3)
  note             String?
  /// 출고에서 파생된 줄이면 그 출고를 가리킨다. 사람이 직접 적은 줄은 비어 있다.
  shipmentId       String?
  shipment         CrmShipment?      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// 생산에서 파생된 줄. 한 번의 생산이 원료 OUT 과 완제품 IN 두 줄을 만든다.
  productionId     String?
  production       CrmProduction?    @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  /// 젤 타입(stockUnit ML)의 줄: 농도(%)가 재고 칸을 가른다. quantity 는 ml
  concentrationPct Decimal?          @db.Decimal(6, 3)
  /// 규격별 젤 행에서 옮겨 온 줄이면 원래 제품 · 원래 수량(개)
  legacyProductId  String?
  legacyQuantity   Decimal?          @db.Decimal(12, 3)

  @@index([productId])
  @@index([movedAt])
  @@index([productId, concentrationPct])
}

/// 생산 기록. 원료를 써서 완제품 몇 개를 만들었는지.
///
/// 이것이 원료와 완제품을 잇는 유일한 고리다. 이게 없으면 "DNA 를 썼는데 제품이
/// 어디서 왔는지" 를 아무도 모른 채 두 장부가 따로 논다 — 엑셀이 그랬다.
model CrmProduction {
  id               String      @id @default(uuid())
  code             String      @unique // MFG260904-001
  producedAt       DateTime
  /// 만든 것
  productId        String
  product          CrmProduct  @relation("ProducedProduct", fields: [productId], references: [id])
  /// 만든 개수 — 지난 규격별 생산에만 있다. 젤 타입 생산은 개수를 세지 않아 비어 있고 totalMl 이 만든 양이다
  quantity         Int?
  /// 쓴 원료. 타입에 이어진 원료가 없으면 비어 있고 차감하지 않는다
  materialId       String?
  material         CrmProduct? @relation("ProductionMaterial", fields: [materialId], references: [id])
  materialGrams    Decimal     @db.Decimal(12, 3)
  note             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  /// 젤 타입 생산(2026-11-25): 농도(%) · 만든 ml
  concentrationPct Decimal?    @db.Decimal(6, 3)
  totalMl          Decimal?    @db.Decimal(12, 3)
  /// 사진(File.id) — POST /api/files 로 올린 공개 파일
  photoFileIds     String[]    @default([])
  legacyProductId  String?

  stockMoves CrmStockMove[]

  @@index([producedAt])
}

// ─── 홈페이지 기사 ──────────────────────────────────────────────
//
// haddscience.com 의 뉴스 기사. 예전에는 사이트 저장소에 JSON 으로 커밋했다(git 이 DB).
// 관리 화면이 Omnis SSO 로 옮겨 오면서 저장도 여기로 왔다 — 정적 사이트가 GitHub 토큰을
// 들 수 없어 서버가 대신 커밋해야 했는데, 그럴 바에는 DB 에 두는 편이 단순하다.
// content · deck 의 모양은 lib/schemas/website.ts 가 정한다 (사이트 content/types.ts 와 같다).

model WebsitePost {
  /// "20260827-1149"(관리 화면이 매김) 또는 아임웹 시절 숫자 id
  id           String   @id
  /// 어느 목록에 속하는가 — "news"(뉴스) · "library"(하드:라이브러리). 화면·주소가 갈린다
  category     String   @default("news")
  /// 목록 순서. 작을수록 위. 옛 order.json 을 대신한다
  position     Int
  /// 목록 맨 위에 고정한다("HADD PICK"). position 을 건드리지 않는 덧씌우기라 풀면 제자리로 돌아간다
  pinned       Boolean  @default(false)
  /// 표시용 날짜 "2026.07.08"
  date         String
  /// 사람이 쓴 언어. 나머지는 여기서 번역된다
  sourceLang   String
  /// 목록 썸네일 URL. 언어 공통
  thumbnail    String?
  /// 외부에 원문이 있으면 그 주소
  externalHref String?
  /// { ko: PostLocale, en?: PostLocale }
  content      Json
  /// 카드뉴스 편집기로 만든 글이면 원본 덱
  deck         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@index([position])
  @@index([category, position])
  @@index([category, pinned, position])
}

/// 기사에 딸린 사진. 실물은 NAS(lib/storage.ts), 여기는 목록 — 기사를 지울 때 함께 지우기 위해서다.
/// postId 는 외래키가 아니다. 새 글은 사진을 먼저 올리고 글을 저장하므로 그 시점엔 기사 행이 없다.
/// 끝내 저장되지 않은 글의 사진은 고아로 남는데, 그건 정리 작업이 거둬 갈 몫이다.
model WebsiteMedia {
  id          String   @id @default(cuid())
  postId      String
  /// NAS 키 "website/<postId>/<id>.webp". 업로드마다 고유하므로 영구 캐시할 수 있다
  key         String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([postId])
}

// ─── 홈페이지 문의 (2026-09-22) ──────────────────────────────────
//
// haddscience.com /contact 폼이 보낸 문의. 사이트가 서버 간 호출로 넣는다
// (POST /api/website/inquiries · 공유 비밀). 설계는
// mydocs/plans/2026-09-22-website-inquiry-to-crm.md 가 정본이다.

enum WebsiteInquiryStatus {
  NEW
  ACCEPTED
  REJECTED
  SPAM
}

/// **CRM 이 아니다.** 폼은 아무나 채울 수 있어서, 받은 것을 바로 CrmOrg 로 넣으면
/// 스팸 한 건이 기관 목록을 더럽히고 되돌리려면 지워야 한다. 여기 먼저 쌓고
/// 사람이 승인할 때만 CrmOrg·CrmContact·CrmQuote 가 생긴다 —
/// orgId·contactId·quoteId 가 승인 전까지 전부 null 인 것이 그 「사람 검토」 의 실체다.
model WebsiteInquiry {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  name         String
  organization String?
  email        String
  phone        String?
  /// sample | pricing | technical | partnership | etc.
  /// 원본은 사이트 content/ko.ts 의 contact.form.topicOptions.
  /// Prisma enum 으로 두지 않는다 — 사이트가 항목을 늘릴 때마다 마이그레이션이 붙는다.
  /// 대신 받는 자리(lib/website-inquiry.ts)가 다섯 값으로 검사한다.
  topic        String
  message      String
  /// ko | en. 검토 화면이 원문 언어를 표시하는 데 쓴다
  lang         String   @default("ko")
  /// 스팸 판정과 레이트리밋에만 쓴다. 서버 간 호출이라 Omnis 가 방문자를 직접 볼 수 없어
  /// 사이트가 넘겨 준 값이다
  ip           String?
  userAgent    String?

  status       WebsiteInquiryStatus @default(NEW)
  /// 관계를 걸지 않는다(CrmPayment.createdById 와 같다) — User 모델을 건드리지 않는다
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  /// 승인해야 채워진다. 기관·담당자·견적·샘플요청이 지워지면 null 로 풀리지만 status 와
  /// reviewedAt 은 남는다 — 「사람이 승인했다」 는 사실이 링크보다 오래 간다.
  orgId     String?
  org       CrmOrg?           @relation(fields: [orgId], references: [id], onDelete: SetNull)
  contactId String?
  contact   CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quoteId   String?
  quote     CrmQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// 샘플 요청으로 받은 문의는 견적이 아니라 이쪽이 생긴다. 둘 중 하나만 차거나 둘 다 비어 있다
  /// (기관·담당자만 등록한 경우) — 어느 쪽이든 status 는 ACCEPTED 다.
  sampleId  String?
  sample    CrmSampleRequest? @relation(fields: [sampleId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// ─── 회사 Context (2026-09-14) ───────────────────────────────────────
//
// HADD DB 에서 모아 보는 회사 자료. 원본은 옴니스다 — 노션·엑셀은 한 번 옮기고 끝낸다.
// 설계: mydocs/plans/2026-09-14-company-context.md
// 세는 자료는 여기(모델), 읽는 서술은 지식 카드(AI 가 갱신), 파일은 NAS.

/// 회사 기본정보. 지원서에 글자 그대로 들어가는 값이라 AI 가 쓰지 않는다 — 카드와 다르다.
model CompanyProfile {
  id             String    @id @default("hadd")
  nameKo         String
  nameEn         String?
  bizRegNo       String
  /// 개인사업자 · 법인. 사업자번호(503-52-…)와 결산서로는 개인과세사업자 — 법인 전환 여부 확인 필요
  bizType        String?
  corpRegNo      String?
  industry       String?
  industryCode   String?
  foundedOn      DateTime?
  homepage       String?
  hqAddress      String?
  labAddress     String?
  partnerAddress String?
  asOfDate       DateTime?
  updatedById    String?
  updatedAt      DateTime  @updatedAt
}

enum FigureBasis {
  /// 확정 — 결산서(신고한 재무제표)
  CONFIRMED
  /// 계획 — 예상·추정. 사업계획서용이고 실적과 섞지 않는다
  PLANNED
}

/// 연도별 재무·인원. 금액은 원, 매출은 공급가액(부가세 제외).
/// 결산 전인 올해의 「잠정」 매출은 저장하지 않고 TaxInvoice 에서 매번 센다.
model CompanyYear {
  id                String      @id @default(uuid())
  year              Int
  basis             FigureBasis
  revenueKrw        BigInt?
  revenueProductKrw BigInt?
  revenueServiceKrw BigInt?
  costOfSalesKrw    BigInt?
  netIncomeKrw      BigInt?
  assetsKrw         BigInt?
  liabilitiesKrw    BigInt?
  equityKrw         BigInt?
  /// 상시근로자
  headcount         Int?
  /// 결산서의 매출 계정 이름 (상품매출 · 서비스수입 …) — 세무사 확인용
  accountLabel      String?
  note              String?
  /// 결산서 원본 (NAS 키)
  sourceFileKey     String?
  asOfDate          DateTime?
  updatedAt         DateTime    @updatedAt

  @@unique([year, basis])
}

enum EmploymentStatus {
  EMPLOYED
  FORMER
}

/// 인력 프로필. 과제 대리 작성에 쓴다. User 가 아닌 사람(외부 연구원)도 담는다.
/// 관리자만 연다. AI 도구에는 이름 · 소속 · 직책 · 담당업무만 싣는다.
model StaffProfile {
  id          String           @id @default(uuid())
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String           @unique
  /// 본 소속 — 하드사이언스 · 성균관대학교 · EAS
  affiliation String
  /// 본 소속에서의 직책
  position    String?
  /// 하드사이언스 겸직 직함 — CAO · CMO
  haddRole    String?
  employment  EmploymentStatus @default(EMPLOYED)
  /// 4대보험 가입
  insured     Boolean          @default(false)
  education   String?
  major       String?
  duties      String?
  /// 과학기술인번호 (NTIS)
  ntisNo      String?
  email       String?
  phone       String?
  birthDate   DateTime?
  joinedOn    DateTime?
  note        String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assets      StaffAsset[]
  /// 채용 지원서에서 입사 처리로 온 사람(3단계 — mydocs/plans/2026-11-24-hr-intake.md)
  application JobApplication?
}

enum StaffAssetKind {
  SIGNATURE
  SEAL
}

/// 서명 · 직인 이미지. 실물은 NAS(lib/storage), 여기엔 키만.
/// 복사 · 내려받기는 누가 · 언제 · 누구의 것을 활동 로그에 남긴다.
model StaffAsset {
  id        String         @id @default(uuid())
  staffId   String
  staff     StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind      StaffAssetKind
  objectKey String
  fileName  String
  mimeType  String
  width     Int?
  height    Int?
  size      Int
  createdAt DateTime       @default(now())

  @@index([staffId])
}

/// 시장 · 경쟁 기업. 거래처(CrmOrg)와 섞지 않는다 — 섞으면 「거래 기관 N곳」 이 부풀려진다.
/// 금액 · 업력 · 규모는 표기가 제각각이라 원문 글자로 둔다.
model MarketCompany {
  id                String   @id @default(uuid())
  name              String   @unique
  /// 이름 괄호에서 뗀 국가
  country           String?
  /// Global · Media & Culture gel · 오가노이드 회사 · Culture chip & dish · CRO
  segment           String?
  homepage          String?
  products          String?
  industry          String?
  ceo               String?
  foundedRaw        String?
  capitalRaw        String?
  revenueRaw        String?
  headcountRaw      String?
  /// 동물대체시험법
  animalAlternative Boolean?
  address           String?
  note              String?
  source            String   @default("notion")
  updatedAt         DateTime @updatedAt
}

enum RecordKind {
  /// 지원사업 (지원금 · 과제번호 · 자부담)
  GRANT
  /// 수상
  AWARD
  /// 학회 · 부스 · 전시
  EXHIBITION
  /// 포럼 · 세미나 참석/발표
  FORUM
  /// 교육 · 멘토링
  EDUCATION
  /// 네트워킹 · 방문
  NETWORKING
  /// 내부행사 · 입주 · 워크샵
  INTERNAL
  /// 그 밖의 주요 사건 (설립 · 인증 취득 …)
  MILESTONE
}

/// 회사 연혁 · 실적. 연혁 표가 상위 집합이고, 지원사업 · 수상 · 학회 시트는 상세 칸이 붙는 부분집합이다.
/// 날짜가 다르면 상세 시트가 정본 (2026-09-10 결정). 특허 · 상표는 ip 스키마가 정본이라 담지 않는다.
model CompanyRecord {
  id            String                @id @default(uuid())
  /// 이식 멱등 키 — kind · 제목 · 기관 · 시작일을 정규화해 만든다 (시작일이 비어도 겹치지 않게)
  dedupeKey     String                @unique
  kind          RecordKind
  title         String
  organizer     String?
  startsOn      DateTime?
  endsOn        DateTime?
  /// 원문 기간 표기. 화면엔 이것을 보여 준다 — 형식이 20종이라 파싱값만 두면 뜻이 상한다
  periodRaw     String?
  /// 완료 · 진행중 · 발표완료 · 계획
  status        String?
  note          String?
  subject       String?
  role          String?
  fundingKrw    BigInt?
  ownCashKrw    BigInt?
  ownInKindKrw  BigInt?
  grantNo       String?
  prize         String?
  venue         String?
  /// 대리점 (EAS · 오리엔트바이오 · 준바이오텍). 비면 자사
  partner       String?
  /// 엑셀 원문 카테고리 (주요 · 내부행사 · 포럼 · 교육 · 네트워킹)
  category      String?
  /// 어느 표에서 왔나 — 연혁 · 지원사업 · 수상 · 학회 · 노션 · 옴니스
  source        String
  projectId     String?
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// 공개범위. INTERNAL 은 대외비 — 외부 자료(기업현황카드 · IR · 홈페이지)에 쓰지 않는다.
  /// 이 칸이 생기기 전에는 제목 앞 [내부용·대외비] 와 비고로만 갈랐다 (2026-10-06)
  visibility    RecordVisibility      @default(PUBLIC)
  /// 이 줄을 만든 AI 제안 (채택 · 자동 등록)
  proposals     RecordProposal[]
  /// 이 연혁이 취득 사건인 인증
  certification CompanyCertification?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([kind, startsOn])
  @@index([startsOn])
}

enum RecordVisibility {
  PUBLIC
  INTERNAL
}

/// 연혁 제안의 등급. 「제외」는 저장하지 않는다 — 제안 단계에서 버린다
enum RecordGrade {
  /// 외부에 내세울 기관 확정 성과 (선정 · 수상 · 협약/MOU · 출원/등록 · 인증 · 기관 위촉) → 기업현황카드 후보
  MAJOR
  /// Omnis 상세 연혁만 (행사 참석 · 부스 · 발표 · 교육 · 현장점검 · 실사)
  GENERAL
}

/// AI 가 채팅 · 업무에서 찾은 연혁 후보. 사람이 채택 · 수정 · 제외로 확정한다.
///
/// 확정 결과가 곧 정확도다 — 원안 그대로 채택한 비율을 종류 × 등급별로 센다.
/// 기준을 넘은 유형(일반 등급 · 대외비 아님)만 자동 등록으로 넘어간다 — lib/record-proposals.ts.
///
/// 배경: mydocs/plans/2026-09-30-record-proposals-and-card-categories.md
model RecordProposal {
  id     String             @id @default(uuid())
  status CardProposalStatus @default(PENDING)

  kind         RecordKind
  grade        RecordGrade
  confidential Boolean     @default(false)
  title        String
  organizer    String?
  occurredOn   DateTime?
  /// 원문 기간 표기 (예: 2026.12.02~12.05)
  periodRaw    String?
  /// 0~1. 모델이 매긴 확신
  confidence   Float
  /// 왜 연혁인지 한 줄
  reason       String
  /// 근거 [{ kind: "task"|"message", id, label, at, quote }]. 비어 있으면 만들지 않는다
  sourceRefs   Json
  /// AI 원안 { kind, grade, confidential, title, occurredOn, organizer } — 사람이 고쳐도 남긴다
  original     Json
  /// 사람이 고쳐서 채택했다. 정확도에서는 「원안과 다름」으로 센다
  edited       Boolean     @default(false)

  /// 무엇이 이 제안을 불렀나 — task_done · chat_daily · manual
  trigger       String
  triggerTaskId String?
  triggerTask   Task?   @relation(fields: [triggerTaskId], references: [id], onDelete: SetNull)

  /// 채택 · 자동 등록으로 생긴 연혁. 연혁이 지워져도 제안(판단 기록)은 남는다
  recordId String?
  record   CompanyRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  decidedById String?
  decidedBy   User?     @relation("RecordProposalDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  /// 자동 등록을 사람이 되돌린 시각. 정확도에 「원안과 다름」으로 들어간다
  revertedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([kind, grade, status])
  @@index([triggerTaskId])
}

enum TaxInvoiceDirection {
  SALE
  PURCHASE
}

/// 홈택스 전자세금계산서. 원본 PDF 는 NAS.
/// 매출 잠정치는 이 표의 공급가액 합으로 센다 (확정은 CompanyYear 의 결산서 값이 이긴다).
model TaxInvoice {
  id                 String              @id @default(uuid())
  approvalNo         String              @unique
  direction          TaxInvoiceDirection
  /// 일반 · 수정
  kind               String              @default("일반")
  originalApprovalNo String?
  issuedOn           DateTime
  supplierBizNo      String
  supplierName       String
  buyerBizNo         String
  buyerName          String
  supplyKrw          BigInt
  taxKrw             BigInt
  totalKrw           BigInt
  orgId              String?
  org                CrmOrg?             @relation(fields: [orgId], references: [id], onDelete: SetNull)
  quoteId            String?
  quote              CrmQuote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// 원본 PDF. 홈택스 목록 엑셀로 들어온 줄은 비어 있다 — 나중에 PDF 가 승인번호로 붙는다(2026-09-17)
  objectKey          String?
  fileName           String?
  /// text(PDF 글자) · vision(AI 판독 — 사람이 확인해야 저장) · excel(홈택스 목록조회)
  readBy             String
  /// 검산 결과 { itemsSumMatches, totalMatches, problems[] }
  checks             Json
  uploadedById       String?
  createdAt          DateTime            @default(now())

  items    TaxInvoiceItem[]
  payments CrmPayment[]

  @@index([issuedOn])
  @@index([orgId])
  @@index([direction, issuedOn])
}

/// 세금계산서 한 장에 들어온 돈(매출) · 나간 돈(매입).
///
/// 나눠 들어오는 일이 있어 여러 줄이다. 합계가 세금계산서 합계에 닿으면 끝난 것으로 본다 —
/// 「입금 완료」 칸을 따로 두지 않는다. 요약 칸은 언젠가 장부와 어긋난다(tech/crm.md 「현재고」 와 같은 이유).
model CrmPayment {
  id          String     @id @default(uuid())
  invoiceId   String
  invoice     TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// 날짜만 — timestamp 로 두면 시간대에 따라 하루가 밀린다(migration-traps)
  paidOn      DateTime   @db.Date
  amountKrw   BigInt
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([invoiceId])
  @@index([paidOn])
}

model TaxInvoiceItem {
  id        String      @id @default(uuid())
  invoiceId String
  invoice   TaxInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo    Int
  name      String
  spec      String?
  quantity  Int?
  unitKrw   BigInt?
  supplyKrw BigInt
  taxKrw    BigInt
  /// 제품 · 용역
  category  String
  productId String?
  product   CrmProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ─── 홈페이지 방문 통계 (2026-09-22) ─────────────────────────────
//
// haddscience.com 의 방문 기록. 사이트가 서버 간 호출로 한 건씩 넣는다
// (POST /api/website/visits · 공유 비밀). 설계는
// mydocs/plans/2026-09-22-website-visit-stats.md 가 정본이다.

/// 방문 한 건. **쿠키도 IP 도 없다** — 방문자 구분은 사이트가 만든 하루짜리 해시로만 한다.
/// 날짜가 해시 키에 들어가므로 어제와 오늘을 이어 붙일 수 없다(같은 사람이 이틀 오면 2명).
model WebsiteVisit {
  id           String   @id @default(uuid())
  at           DateTime @default(now())
  /// "/ko/news/170271833" — 질의문자·해시는 사이트가 떼고 보낸다
  path         String
  /// "ko" | "en"
  lang         String
  /// 그날 한정 해시(사이트에서 HMAC). 원본 IP·UA 는 여기까지 오지 않는다
  visitorHash  String
  /// 유입 호스트 "google.com". 내부 이동과 직접 입력은 null.
  /// 전체 URL 을 두지 않는 이유는 검색어가 붙어 오는 경우가 있기 때문이다
  referrerHost String?
  /// "mobile" | "desktop" — 사이트가 UA 를 보고 판정해 보낸다
  device       String

  @@index([at])
  @@index([path, at])
}

// ─── 운영 KPI (2026-10-16) ─────────────────────────────────────
//
// 「옴니스가 제 역할을 하는가」를 숫자로 보기 위한 재료. 설계는
// mydocs/plans/2026-10-16-kpi-metrics.md 가 정본이다.

/// 업무가 바뀐 기록 한 줄. **값이 실제로 바뀔 때만** 남는다 — 같은 상태로 다시 저장하면 없다.
/// 상태 이력이 없어 「언제 끝났나」「AI 가 바꿨나 사람이 바꿨나」를 물을 수 없었다(2026-10-16).
model TaskEvent {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 바꾼 사람. AI·이식이 바꾸면 시스템 계정(SYSTEM_USER_ID). 사용자 삭제와 엮지 않으려 관계를 두지 않는다
  actorId   String?
  /// lib/schemas/task-event.ts 의 TASK_EVENT_VIA — "web" | "mcp" | "chat-ai" | "notification" | "import"
  via       String
  /// lib/schemas/task-event.ts 의 TASK_EVENT_FIELDS — "created" | "status" | "assignees" | "deadline" | "archived" | "checklist"
  field     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([field, createdAt])
}

/// 하루치 지표 한 칸. 세로 모양이라 지표를 늘려도 마이그레이션이 없다.
/// 하루 크론(app/api/cron/daily)이 어제·오늘을 다시 계산해 덮어쓴다.
model KpiDaily {
  /// 한국 날짜
  day       DateTime @db.Date
  /// lib/kpi.ts 의 지표 이름 — "users.active", "tasks.done" …
  key       String
  value     Float
  /// 내역(경로별 AI 호출 수 등). 값만으로 충분하면 null
  detail    Json?
  updatedAt DateTime @updatedAt

  @@id([day, key])
}

// ─── 홈페이지 칼럼: 키워드 추천 → AI 초안 → 라이브러리 게시 ─────────────
// 설계: mydocs/plans/2026-10-16-column-keyword-pipeline.md
// 사람을 가리키는 칸(createdById 등)은 WebsiteInquiry.reviewedById 처럼 관계를 걸지 않는다 — User 모델을 건드리지 않는다.
// 임베딩은 pgvector 가 아니라 Float[] 다. 비교 대상이 라이브러리 100여 건 + 후보 수십 건이라
// 메모리에서 코사인을 재는 편이 단순하고, 지식 검색용 EmbeddingChunk 를 섞지 않는다.

/// 후보 수집 한 번. 한도 추적을 위해 걸린 시간과 CPU 시간을 남긴다.
model ColumnKeywordRun {
  id          String          @id @default(uuid())
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  /// [{feed, url, fetched, ok, error?}]
  sources     Json            @default("[]")
  model       String
  tokensIn    Int?
  tokensOut   Int?
  /// 벽시계 시간(ms) — Provisioned Memory 추정에 쓴다
  durationMs  Int?
  /// 프로세스 CPU 시간(ms) — Active CPU 추정에 쓴다
  cpuMs       Int?
  /// 실행 버튼을 누른 사람
  createdById String
  keywords    ColumnKeyword[]
}

model ColumnKeyword {
  id            String            @id @default(uuid())
  /// 사람이 손으로 넣은 키워드는 null
  runId         String?
  run           ColumnKeywordRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// 표시용 "오가노이드 동물대체시험 가이드라인"
  term          String
  /// 공백·기호를 뺀 소문자. 같은 키워드를 두 번 저장하지 않는다
  normalized    String            @unique
  /// 정책 · 산업 · 연구 · 규제 · 투자 · 기술 (lib/column/types.ts 의 TOPICS)
  topic         String
  /// 주제 설명 2~3문장
  summary       String
  /// [{title, url, publisher, date}] — 피드에서 실제로 읽은 항목만. 모델이 URL 을 쓰지 않는다
  sources       Json              @default("[]")
  /// 근거 중 가장 최근 날짜(시의성)
  timelyAt      DateTime?
  /// candidate · reserved · used · discarded
  status        String            @default("candidate")
  /// 「예약」을 누른 사람
  reservedById  String?
  reservedAt    DateTime?
  /// 로테이션용 자리. 이번 범위에서는 쓰지 않는다
  assigneeId    String?
  /// gemini-embedding-001 768차원, L2 정규화
  embedding     Float[]
  /// 가장 비슷한 기존 라이브러리 글과 그 코사인 유사도
  nearestPostId String?
  nearestScore  Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  drafts        ColumnDraft[]

  @@index([status])
}

model ColumnDraft {
  id               String        @id @default(uuid())
  keywordId        String
  keyword          ColumnKeyword @relation(fields: [keywordId], references: [id], onDelete: Restrict)
  /// 「초안 만들기」를 누른 사람 — 사용 이력의 단위
  createdById      String
  /// 로테이션용 자리. 이번 범위에서는 쓰지 않는다
  assigneeId       String?
  /// draft · in_review · changes_requested · approved · published
  status           String        @default("draft")
  title            String
  summary          String
  /// 사이트 PostBlock[] 그대로 — 게시 때 변환하지 않는다
  blocks           Json
  /// 이미지 제안(검토용, 게시되지 않는다) — lib/column/image-suggest.ts. null = 제안 없이 만든 옛 초안
  imageSuggestions Json?
  model            String
  durationMs       Int?
  cpuMs            Int?
  reviewerId       String?
  reviewNote       String?
  /// 게시된 WebsitePost id
  postId           String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([keywordId])
  @@index([status])
}

/// 기존 라이브러리 글의 임베딩 캐시. 제목+부제가 바뀌면(contentHash) 다시 만든다.
model ColumnPostEmbedding {
  postId      String   @id
  contentHash String
  embedding   Float[]
  updatedAt   DateTime @updatedAt
}

// ─── 캘린더 (2026-10-28) ─────────────────────────────────────

/// 외부 캘린더 하나(네이버 웍스 CalDAV 컬렉션)와 그 동기화 커서.
///
/// 캘린더 id 는 웍스에서 캘린더를 다시 만들면 바뀐다. 그래서 설정(`CALDAV_CALENDARS`)은
/// 표시 이름으로 고르고, 이 행은 찾은 결과를 담는다 — mydocs/tech/calendar.md 4장.
model ExternalCalendar {
  id          String           @id @default(uuid())
  /// "naver-works"
  provider    String
  /// CalDAV 경로의 마지막 칸 (c_{숫자}_{uuid} 꼴)
  externalId  String
  href        String
  displayName String
  /// 옴니스에서 누가 보는가. 웍스에서 보이는 사람과 옴니스 구성원이 같다는 보장이 없어
  /// 처음엔 관리자만 — 관리자가 캘린더 화면에서 연다.
  audience    CalendarAudience @default(ADMIN)
  /// 컬렉션의 마지막 변경 시각(CS:getctag). 같으면 이번 주기에 아무것도 당기지 않는다
  ctag        String?
  /// sync-collection 커서. 서버가 주는 값이 평문 시각이라 3초 되돌려 저장한다(같은 초의 변경을 놓치지 않게)
  syncToken   String?
  /// 마지막으로 성공한 시각
  syncedAt    DateTime?
  /// 마지막으로 시도한 시각 — 실패해도 남긴다. 열람 시 갱신의 60초 판정이 이것을 본다
  attemptedAt DateTime?
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  events ExternalCalendarEvent[]

  @@unique([provider, externalId])
}

enum CalendarAudience {
  ALL
  ADMIN
}

/// 외부 캘린더에서 들여온 일정. 옴니스 안에 집이 없는 데이터만 담는다 —
/// 업무·견적처럼 옴니스가 원본인 날짜는 여기 복사하지 않고 읽을 때 모은다(lib/calendar).
///
/// 반복 일정은 마스터만 담고 펼치지 않는다. 펼친 회차를 쌓으면 끝없는 반복에 끝이 없고,
/// 규칙이 바뀔 때마다 지우고 다시 넣어야 한다. 조회 창에 맞춰 그때 펼친다.
model ExternalCalendarEvent {
  id           String           @id @default(uuid())
  calendarId   String
  calendar     ExternalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// iCalendar UID. 마스터와 그 예외 회차가 **같은 UID** 를 쓴다
  uid          String
  /// 예외 회차의 원래 시각(RECURRENCE-ID 를 UTC ISO 로). 마스터는 빈 문자열이다 —
  /// null 로 두면 Postgres 유니크 키가 null 끼리 겹치는 것을 막지 못한다
  recurrenceId String           @default("")
  /// 이 일정이 든 .ics 리소스. 마스터와 예외가 한 리소스에 같이 든다
  href         String
  etag         String?
  summary      String
  description  String?
  location     String?
  /// 첫 회차(반복이면 마스터의 DTSTART)
  startAt      DateTime
  endAt        DateTime
  /// 종일 일정(VALUE=DATE). 이때 startAt 은 서울 자정이고 endAt 은 끝 다음 날 서울 자정이다
  isAllDay     Boolean          @default(false)
  tzid         String?
  rrule        String?
  exdates      DateTime[]
  /// 반복의 마지막 회차가 끝나는 시각. 끝없는 반복이면 null — 조회 창을 거를 때 쓴다
  recurUntil   DateTime?
  /// CONFIRMED · TENTATIVE · CANCELLED
  status       String?
  sequence     Int              @default(0)
  lastModified DateTime?
  /// ORGANIZER 의 메일 주소. 옴니스 사용자와는 메일로만 맞춘다(auth-architecture)
  organizer    String?
  /// [{ email, name, partstat }]
  attendees    Json?
  /// sync-collection 의 404 묘비. 지우지 않고 가린다
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([calendarId, uid, recurrenceId])
  @@index([calendarId, startAt])
  @@index([href])
}

// ─── 옴니스 에이전트 (메신저 3단계) ─────────────────────────────
// 계획: mydocs/plans/2026-10-28-omnis-messenger-agent.md 3단계 · 구현: lib/agent/
//
// userId · roomId 는 관계(@relation)를 두지 않은 문자열이다. User · ChatRoom 모델을 고치지 않으려는 것 —
// 같은 때 다른 브랜치(feat/omnis-messenger)가 두 모델에 칸을 더하고 있고, 사용 기록은 방 · 사람이 바뀌어도 남아야 한다.

/// 옴니스 1:1 방에서 질문 하나에 대한 에이전트 실행. 쓰기 확인을 기다리는 동안 멈췄다가 같은 실행으로 이어 간다
model AgentRun {
  id                String         @id @default(uuid())
  roomId            String
  userId            String
  /// 이 실행을 연 내 글(ChatMessage.id)
  questionMessageId String
  status            AgentRunStatus @default(RUNNING)
  /// "openai:gpt-6.1-sol" — lib/ai-models.ts
  model             String
  /// 지금까지의 대화(AI SDK ModelMessage[]). 확인 뒤 이어 갈 때 여기에 승인 응답을 붙여 다시 넣는다
  messages          Json
  /// 지금까지 부른 모델 호출 수 — 실행당 상한(lib/ai-models.ts AGENT_LIMITS)
  turns             Int            @default(0)
  costKrw           Decimal        @default(0) @db.Decimal(12, 4)
  /// 지금 돌고 있는(또는 마지막) Workflow 실행 id — 새로고침 뒤 스트림을 다시 붙는 데 쓴다
  workflowRunId     String?
  /// 찾은 사내 지식 조각 [{ id, source, sourceId, title, sourceLabel, similarity }] — 답의 각주 [n] 이 이 순서를 가리킨다
  sources           Json           @default("[]")
  error             String?
  /// 멈춘(STOPPED) 실행이 남긴 옴니스 글 — 그때까지 흘러나온 답. 화면이 이 글에 「중지됨」 을 붙인다. 글 없이 멈췄으면 null
  stoppedMessageId  String?
  /// 사람 방의 @옴니스 로 연 첫 실행 — 끝나면(답 · 확인 대기 · 실패) 그 방에 안내 한 줄을 남긴다. 완료를 알린 뒤 false
  notifyOrigin      Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  steps             AgentStep[]

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

enum AgentRunStatus {
  RUNNING
  /// 쓰기 제안 카드에 사람의 확인을 기다린다
  AWAITING_APPROVAL
  DONE
  FAILED
  /// 턴 · 원 상한에 닿아 멈췄다
  LIMIT
  /// 확인을 기다리는 동안 새 글이 와서 버렸다
  CANCELLED
  /// 답하는 중에 사용자가 「답변 중지」 를 눌렀다 (CANCELLED 와 다르다 — 그건 새 글이 앞 제안을 버린 것)
  STOPPED
}

/// 쓰기 제안 하나 = 확인 카드 하나. 승인은 화면에 보인 제안(planHash)에 묶이고 한 번만 쓴다
model AgentStep {
  id            String          @id @default(uuid())
  runId         String
  run           AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId    String
  /// AI SDK 의 tool-approval-request id
  approvalId    String
  toolName      String
  input         Json
  /// 확인 카드 — 제목 · 대상 · 전 → 후 · 위험 이유 (lib/agent/preview.ts)
  preview       Json
  /// sha256(run · 도구 · 입력 · 카드). 화면이 보낸 값과 같아야 승인된다
  planHash      String
  status        AgentStepStatus @default(PENDING)
  /// 비밀번호 · 인증 정보 · 개인 식별번호가 보여 막은 이유 (lib/agent/secrets.ts)
  blockedReason String?
  /// 실행 결과(도구가 돌려준 글) 또는 실패 이유
  result        String?
  decidedById   String?
  decidedAt     DateTime?
  executedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@unique([runId, toolCallId])
  @@index([runId])
}

enum AgentStepStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
  EXECUTED
  FAILED
  /// 확인 전에 실행이 버려졌다(새 글)
  EXPIRED
}

/// 벤더 중립 AI 사용 기록 — 모델 호출 한 번에 한 줄. GeminiUsage 는 그대로 두고 새 기능부터 여기에 남긴다
model AiUsage {
  id                String   @id @default(uuid())
  /// openai · anthropic · google
  vendor            String
  model             String
  /// 기능 이름 — "agent" …
  feature           String
  /// 입력 토큰 전체(캐시 읽기 포함)
  inputTokens       Int
  cachedInputTokens Int      @default(0)
  /// 출력 토큰 전체(추론 포함)
  outputTokens      Int
  reasoningTokens   Int      @default(0)
  /// 요금표(lib/ai-pricing.ts)로 환산한 값. 요금표에 없는 모델이면 0
  costUsd           Decimal  @default(0) @db.Decimal(12, 6)
  costKrw           Decimal  @default(0) @db.Decimal(12, 4)
  /// 캐시 쓰기 토큰(Anthropic 은 입력 단가의 1.25배 · 2배로 따로 받는다). inputTokens 에 들어 있다
  cacheWriteTokens  Int      @default(0)
  /// 실행 환경이 돈 시간(초) — 작업용 컴퓨터(Managed Agents 세션 $0.08/시간). 토큰만 쓰는 기능은 0
  activeSeconds     Int      @default(0)
  userId            String?
  roomId            String?
  runId             String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
}

/// 작업용 컴퓨터 작업 1건(Claude Managed Agents 세션 1개). 0단계 — 정우창 계정에서만(WORKBENCH_USER_IDS).
/// 옴니스 에이전트가 「작업용 컴퓨터로 넘기기」 카드(start_workbench)로 만든다 → Workflow 가 세션을 열고 진행을 채팅방에 한 줄씩 →
/// 끝나면 결과 파일을 File 로 받아 채팅방에 붙이고 세션 · vault · 단기 MCP 토큰을 지운다. 계획: lib/workbench/runner.ts 머리말
model WorkbenchJob {
  id               String    @id @default(uuid())
  userId           String
  /// 진행 · 결과가 붙는 방(요청한 옴니스 1:1 방)
  roomId           String
  /// 카드를 띄운 옴니스 에이전트 실행
  runId            String?
  /// 샌드박스 에이전트에게 넘긴 일(사람 말 그대로 + 옴니스 에이전트가 정리한 것)
  request          String    @db.Text
  model            String
  /// QUEUED · RUNNING · NEEDS_BUDGET · DONE · FAILED · CANCELLED
  status           String    @default("QUEUED")
  /// 지금 세션 예산(원). 「계속」 하면 오른다
  budgetKrw        Int
  /// 살아 있는 동안만 — 끝나면 지우고 null 로 둔다
  sessionId        String?
  vaultId          String?
  /// ip.oauth_tokens.id — 요청자 권한의 단기 MCP 토큰(원문은 저장하지 않는다)
  tokenId          String?
  /// 마지막으로 가져온 이벤트의 processed_at
  cursor           String?
  lastMessage      String?   @db.Text
  inputTokens      Int       @default(0)
  cacheWriteTokens Int       @default(0)
  cacheReadTokens  Int       @default(0)
  outputTokens     Int       @default(0)
  activeSeconds    Int       @default(0)
  costUsd          Decimal   @default(0) @db.Decimal(12, 6)
  costKrw          Decimal   @default(0) @db.Decimal(12, 2)
  outputFileIds    String[]  @default([])
  error            String?
  workflowRunId    String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

/// AI 활용 설문(2026-11-11) — 질문 · 제시한 폼 · 응답 원문(turns)과 거기서 환산한 지표(metrics).
/// 한 사람이 다시 할 수 있다 — 앞 응답은 기록으로 남고, 「지금 응답」 은 그 사람의 가장 최근 행, 집계는 가장 최근에 제출한 1건(lib/ai-survey/entry.ts).
/// 원문은 본인과 관리자만 본다. 모양: lib/ai-survey/rules.ts(Turn · Facts) · metrics.ts(Metrics)
model AiSurvey {
  id          String    @id @default(uuid())
  userId      String
  /// IN_PROGRESS · CONFIRM(요약 확인 대기) · SUBMITTED
  status      String    @default("IN_PROGRESS")
  turns       Json      @default("[]")
  /// 칸별 응답 — 충족도 · 지표의 원천
  facts       Json      @default("{}")
  summary     String?
  metrics     Json?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([userId, createdAt])
}

// ─── UI 변경 적응 부담 측정 ───────────────────────────────

/// 화면 사용 기록. 이름 · 숫자 · 경로 형태 · 배포 커밋만 둔다. 내용은 받지 않는다(lib/ui-metrics/rules.ts).
/// 90일 뒤 cron/daily 가 지운다.
model UiEvent {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// lib/ui-metrics/rules.ts 의 UI_EVENT_NAMES
  name      String
  value     Int?
  /// "/chat/:id" — ID · 이름은 지운 형태
  path      String
  /// 그 화면을 그린 빌드의 VERCEL_GIT_COMMIT_SHA
  commitSha String

  @@index([at])
  @@index([commitSha, at])
  @@index([userId, commitSha])
}

/// 배포 다음 날 묻는 한 문항. score 가 null 이면 답하지 않고 닫았다 — 다시 묻지 않으려고 남긴다.
model UiSurveyResponse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitSha String
  score     Int?
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, commitSha])
  @@index([commitSha])
}

/// 옴니스(앱 AI)가 「지금 기능이 없어 못 한다」 고 본 요청 — 사용자가 확인하면 개발자에게 전달한다.
/// 같은 요청(key = 정규화한 제목)은 열린 것 하나로 묶고 요청마다 FeatureRequestEntry 를 붙인다.
/// mydocs/plans/2026-11-10-app-ai-mcp-parity.md
model FeatureRequest {
  id        String                @id @default(uuid())
  /// lib/feature-requests.ts featureKey — 묶기 기준
  key       String
  title     String
  /// NEW 새로 · REVIEW 검토 · DONE 완료
  status    String                @default("NEW")
  /// 묶인 요청 수
  count     Int                   @default(1)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  entries   FeatureRequestEntry[]

  @@index([key, status])
  @@index([status, updatedAt])
}

model FeatureRequestEntry {
  id          String         @id @default(uuid())
  requestId   String
  request     FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User           @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  /// 요청이 나온 옴니스 대화 — /chat/{roomId}
  roomId      String?
  runId       String?
  /// 사용자가 원한 것
  detail      String
  /// AI 가 해 본 것 · 막힌 까닭
  attempted   String?
  createdAt   DateTime       @default(now())

  @@index([requestId, createdAt])
}

/// 재배포 없이 바꾸는 운영 설정 — 관리자 화면이 쓴다. value 의 모양은 key 마다 lib 에 있다.
///   ai_budget                       lib/ai-budget.ts BudgetSettings(사람별 하루 · 회사 월 상한 · 사람별 예외)
///   feature_request_recipients      lib/feature-requests.ts — 기능 요청 · 비용 알림 받는 사람
///   ai_budget_alert:YYYY-MM:80|100  월 상한 알림을 보낸 표시(같은 달 같은 단계는 한 번)
///   hr_reviewers                    lib/hr/reviewers.ts — 채용 지원서를 보는 사람({ userIds })
/// mydocs/plans/2026-11-10-ai-budget.md
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─── 채용(HR) — mydocs/plans/2026-11-24-hr-intake.md ─────────────────

enum JobApplicationStage {
  /// 파일을 올리는 중 — 지원서함에 보이지 않는다. 24시간 안에 접수되지 않으면 cron/daily 가 지운다
  RECEIVING
  RECEIVED
  SCREENING
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
  HIRED
}

enum JobApplicationFileSlot {
  RESUME
  PORTFOLIO
}

/// 홈페이지 채용 지원서(POST /api/website/applications). 공고는 홈페이지 content 에 있어 slug · 제목 사본만 둔다.
/// 개인정보다 — 채용 담당(AppSetting hr_reviewers)만 연다. 열람 · 내려받기는 ActivityLog 에 남긴다.
/// purgeAfter 가 지나면 cron/daily 가 개인정보 칸 · 파일 · 메모를 지우고 purgedAt 을 찍는다(행은 집계용으로 남긴다).
/// 그래서 지원자가 쓴 칸은 모두 비울 수 있게(String?) 둔다.
model JobApplication {
  id       String              @id @default(uuid())
  /// 접수 번호 APP261124-001 — 접수(complete) 때 매긴다. 그 전에는 비어 있다
  code     String?             @unique
  jobSlug  String
  jobTitle String
  lang     String              @default("ko")
  stage    JobApplicationStage @default(RECEIVING)

  name         String?
  department   String?
  studentId    String?
  /// 공고마다 학년 · 경력 등 — 글자로 둔다
  grade        String?
  graduation   String?
  phone        String?
  email        String?
  portfolioUrl String?
  /// 「관심 있는 일」 — 공고의 tracks value(ai-bio · dev · grants …). 선택이라 비어 있어도 된다. 라벨은 lib/hr/rules.ts INTEREST_LABEL
  interests    String[] @default([])
  motivation   String?

  consentAt      DateTime?
  /// 지원자가 본 동의 안내문의 판(홈페이지가 보낸다)
  consentVersion String?
  ip             String?
  userAgent      String?
  receivedAt     DateTime?

  decidedAt        DateTime?
  /// 「선발 종료」 — 채용 담당이 공고 단위로 누른다. purgeAfter = 이 시각 + 6개월
  selectionEndedAt DateTime?
  /// 비어 있으면 접수 12개월 뒤(안전장치) — lib/hr/rules.ts purgeDeadline
  purgeAfter       DateTime?
  purgedAt         DateTime?
  staffProfileId   String?       @unique
  staffProfile     StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files  JobApplicationFile[]
  events JobApplicationEvent[]

  @@index([jobSlug, stage])
  @@index([purgeAfter])
  @@index([email, createdAt])
}

/// 지원서 파일. 실물은 NAS 의 채용 전용 폴더(career/{applicationId}/{slot}.pdf). 채팅 첨부(File)와 섞지 않는다 —
/// File 은 읽는 길이 넓어 볼 사람을 좁힐 수 없다.
model JobApplicationFile {
  id            String                 @id @default(uuid())
  applicationId String
  application   JobApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slot          JobApplicationFileSlot
  objectKey     String
  /// 지원자가 올린 파일 이름 — 파기 때 비운다(이름에 지원자 이름이 들어가곤 한다)
  fileName      String?
  /// 지원자가 알린 크기. 접수 때 NAS 의 크기와 대조한다
  size          Int
  receivedBytes Int                    @default(0)
  mimeType      String                 @default("application/pdf")
  uploadedAt    DateTime?
  /// 파기로 NAS 에서 지운 시각
  deletedAt     DateTime?

  @@unique([applicationId, slot])
}

/// 단계 이력 · 메모 — 누가 언제 무엇을 바꿨는지. note 는 개인정보가 들어가므로 파기 때 비운다
model JobApplicationEvent {
  id            String               @id @default(uuid())
  applicationId String
  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// User.id. 시스템(접수 · 파기)은 null
  actorId       String?
  fromStage     JobApplicationStage?
  toStage       JobApplicationStage?
  note          String?
  createdAt     DateTime             @default(now())

  @@index([applicationId, createdAt])
}

/// 공고마다 옴니스가 따로 갖는 면접 정보(2026-11-26). 공고 자체(이름 · 마감)는 홈페이지 원문이 정본이라(lib/hr/jobs.ts)
/// 여기에는 홈페이지에 없는 칸만 둔다. 줄이 없으면 아직 아무도 적지 않은 것이다. 모양 검사는 lib/schemas/hr-job.ts
model JobPostingMeta {
  /// 홈페이지 공고 slug(JobApplication.jobSlug 와 같은 값)
  jobSlug        String   @id
  /// [{ date: "2026-12-01", time: "11:00", minutesEach?: 10 }] — 날짜순. 비면 []
  interviewSlots Json     @default("[]")
  interviewPlace String?
  /// IN_PERSON(대면) · VIDEO(화상) — 비면 정하지 않음
  interviewMode  String?
  /// 화상 면접 링크(https) — 대면이면 비운다
  videoUrl       String?
  memo           String?
  /// User.id — 마지막으로 고친 사람
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── 인증 · 국가과제 결정 (2026-11-25) ─────────────────────────
// 설계: omnis-reports/gov-grants/omnis-cert-decision-proposal-261125.md. 이식 원천은 수집기 export/v1

enum CertStatus {
  HELD // 보유
  RENEWAL_DUE // 갱신·재발급 필요(법인 전환 포함)
  CANDIDATE // 취득 후보
  NOT_ELIGIBLE // 지금은 자격 안 됨
  EXPIRED
}

/// 회사 인증 · 가점. 연혁(CompanyRecord MILESTONE)은 취득 사건이고, 이 표는 지금 상태다
model CompanyCertification {
  id           String         @id @default(uuid())
  /// 수집기 certifications.json 의 key(cert:…) — 이식 멱등 키
  externalKey  String         @unique
  name         String
  officialName String?
  issuer       String?
  status       CertStatus
  acquiredOn   DateTime?
  validUntil   DateTime?
  certNo       String?
  /// 노션 우선순위(상·중·하)
  priority     String?
  difficulty   String?
  /// 가점 원문. 공고마다 달라 숫자로 두지 않는다 — { medibio, mss, examples[] }
  bonus        Json?
  /// 조사 결과 원문(자격조건 · 우리 충족 여부와 이유 · 신청기간 · 걸리는 기간 · 비용 · 유효기간 · 근거)
  research     Json?
  researchedAt DateTime?
  note         String?
  /// 취득 사건 연혁. 연혁은 그대로 두고 잇기만 한다
  recordId     String?        @unique
  record       CompanyRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

/// 국가과제에 대한 우리 결정(노션 「지원사업」 51건에서 시작). 공고 본문은 수집기 내보내기가 정본
model GrantDecision {
  id             String               @id @default(uuid())
  /// notion:<페이지ID> 또는 수집기 key(group:… / notice:…) — 이식 멱등 키
  externalKey    String               @unique
  title          String
  /// 상태 — PREPARING 준비 · SUBMITTED 제출 완료 · SELECTED 선정됨 · REJECTED 미선정 · IN_PROGRESS 수행 중 · COMPLETED 완료 · STOPPED 중단.
  /// enum 이 아니라 text + CHECK(GrantDecision_stage_check) — 이름표 · 순서는 lib/grants-labels.ts
  stage          String
  /// 불참 사유(자격 미달 · 접수 기간 지남), 선정의 「수행 완료」
  stageReason    String?
  /// 노션 원래 상태(가능성검토 · 지원기간마감 …)
  statusRaw      String?
  /// NAS 「(2026) 예비 지원과제」 안의 이 과제 폴더 — /HADD Science/… 경로. 안의 파일은 /api/nas 로 연다
  nasFolder      String?
  /// nasFolder 를 정한 쪽 — auto(이식 때 이름 유사도) · user(화면 · 도구). user 면 이식이 다시 채우지 않는다
  nasFolderBy    String?
  submittedTitle String?
  note           String?
  deadline       DateTime?
  /// 지원금액 원문
  amount         String?
  /// 선정됨 — 선정 통보일 · 확정 지원금(원)
  selectedOn     DateTime?
  awardedAmount  BigInt?
  /// 수행 중 — 협약일 · 수행 시작일 · 수행 종료일
  agreementOn    DateTime?
  startsOn       DateTime?
  endsOn         DateTime?
  /// 완료 — 완료일
  completedOn    DateTime?
  /// 조사 결과 원문(자격조건 · 2027 신청기간 · 선정까지 기간)
  research       Json?
  /// 수집기 공고 연결 [{relation, notice, export_key, title, date}]
  noticeLinks    Json?
  owners         GrantDecisionOwner[]
  /// 신청 업무 카드
  taskId         String?
  task           Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// 선정 뒤 과제 프로젝트
  projectId      String?
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([stage])
  @@index([deadline])
}

model GrantDecisionOwner {
  decisionId String
  decision   GrantDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 제출 · 지원 · 책임 · 제안서 작성 · 발표
  role       String?

  @@id([decisionId, userId])
}

/// 수집기 공고(대표 공고 · export/v1 notices.json). 판정 · 마감 · 지역으로 「과제 후보」 를 고른다.
/// 수집기가 정본이라 이식 때마다 통째로 맞춘다 — 사람이 고치는 칸은 두지 않는다(올리면 GrantDecision 이 생긴다)
model GrantNotice {
  id           String    @id @default(uuid())
  /// notice:… / group:… — 수집기 key. GrantDecision.noticeLinks 의 export_key 와 같다
  externalKey  String    @unique
  title        String
  ministry     String?
  agency       String?
  url          String?
  rcptStartAt  DateTime?
  deadlineAt   DateTime?
  deadlineRaw  String?
  /// national · gyeonggi · gyeonggi_other · local · other_region · unknown
  regionClass  String?
  regionDetail String[]
  fields       String[]
  isRnd        Boolean?
  /// 해당 · 애매 · 비해당 · 불명 — 개인사업자(지금) 기준과 법인 기준
  verdictSole  String?
  verdictCorp  String?
  /// [{claim, quote}] — 판정 근거
  reasonsSole  Json?
  reasonsCorp  Json?
  /// llm · rules
  judgedBy     String?
  /// 공고 첨부 [{name, type, size, url, page?}] — 기업마당(bizinfo) 첨부는 받을 때 새 토큰이 필요해 page(공고 페이지)를 함께 둔다
  attachments  Json?
  firstSeen    DateTime?
  lastSeen     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deadlineAt])
  @@index([verdictSole])
  @@index([regionClass])
}

// ─── 공통 층 유형 정의 (2026-11-27, P2) — mydocs/plans/2026-11-27-ontology-phase1.md §3-1 ───
// 정본은 코드(lib/objects/types)다. 이 표들은 `pnpm run objects:sync` 가 옮긴 결과일 뿐이고, 아직 읽는 코드가 없다.
// 값 칸(storage · dataType · kind · risk …)은 enum 대신 text + CHECK 다(마이그레이션 SQL 에 직접 쓴다).
// 되돌리기: prisma/rollbacks/20261127200000_object_definitions.down.sql

/// 유형 정의 한 줄
model ObjectType {
  /// 바뀌지 않는 키. ^[a-z][a-z0-9_]{1,39}$. 회사가 만든 유형(2단계)은 c_ 로 시작
  key              String    @id
  label            String
  labelPlural      String?
  /// product | company(2단계)
  origin           String    @default("product")
  /// table | ledger | generic(2단계)
  storage          String
  /// table · ledger: "public.CompanyRecord" · "ip.trademarks"
  backing          String?
  version          Int       @default(1)
  /// 정규화한 정의(칸 · 선택지 · Action 포함)의 sha256
  defHash          String
  llmDescription   String
  /// [{ text, note? }] — 1개 이상
  examples         Json
  /// fixed | inherit | column
  visibilityPolicy String
  visibilityFixed  String[]  @default([])
  aiPropose        Boolean   @default(false)
  /// { groupBy, minDecided, minRate, streak } — null 이면 늘 사람이 본다
  autoApply        Json?
  /// [{ key, label, toType, via }]
  links            Json      @default("[]")
  hiddenAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fields   ObjectField[]
  actions  ActionType[]
  versions ObjectTypeVersion[]
}

/// 유형의 칸
model ObjectField {
  id             String     @id @default(uuid())
  typeKey        String
  type           ObjectType @relation(fields: [typeKey], references: [key], onDelete: Cascade)
  key            String
  label          String
  /// text | longtext | number | money_krw | date | datetime | bool | option | multi_option | ref | person | file | url
  dataType       String
  optionSetKey   String?
  refTypeKey     String?
  /// file 칸: { multiple, accept: ["image/*", "application/pdf"] }
  fileRule       Json?
  /// 공통 틀 칸: title | startsOn | endsOn | owner | org | visibility
  frame          String?
  /// table · ledger: 기대는 칼럼(Prisma 필드 이름)
  column         String?
  readOnly       Boolean    @default(false)
  required       Boolean    @default(false)
  filterable     Boolean    @default(false)
  sortable       Boolean    @default(false)
  aiExtract      Boolean    @default(false)
  llmDescription String?
  maxLength      Int?
  /// 이 칸이 처음 생긴 유형 버전
  sinceVersion   Int        @default(1)
  /// 코드에서 빠지면 지우지 않고 숨긴다
  hiddenAt       DateTime?

  @@unique([typeKey, key])
}

/// 선택지 한 줄 — 여러 칸이 같은 묶음(setKey)을 쓸 수 있다
model OptionValue {
  id          String    @id @default(uuid())
  setKey      String
  /// 묶음 이름표(묶음 안 모든 줄이 같다)
  setLabel    String
  key         String
  label       String
  sortOrder   Int       @default(0)
  /// 기존 enum · text 값 — "GRANT", "PREPARING"
  legacyValue String?
  hiddenAt    DateTime?

  @@unique([setKey, key])
  @@unique([setKey, legacyValue])
}

/// 유형의 동작 — 1단계는 모두 기존 도구(runTool)를 감싼다
model ActionType {
  id            String     @id @default(uuid())
  typeKey       String
  type          ObjectType @relation(fields: [typeKey], references: [key], onDelete: Cascade)
  key           String
  label         String
  /// create | update | upsert | delete | transition | custom
  kind          String
  /// 감싼 기존 도구(lib/tools/registry.ts 의 이름)
  tool          String?
  /// 공통 층 칸 키 → 도구 인자(P10 에서 채운다)
  argMap        Json       @default("{}")
  inputSchema   Json       @default("{}")
  /// read | write | ledger | destructive
  risk          String
  /// card | param (lib/tools/registry.ts 와 같은 뜻 — sync 가 레지스트리에서 옮긴다)
  confirm       String?
  /// { mcp, agent, ask } (P10 에서 채운다)
  expose        Json       @default("{}")
  maxRows       Int        @default(1)
  transactional Boolean    @default(true)
  aiAutoApply   Boolean    @default(false)
  sinceVersion  Int        @default(1)
  hiddenAt      DateTime?

  @@unique([typeKey, key])
}

/// 유형 정의가 바뀔 때마다 한 줄 — 그때의 정의 전체
model ObjectTypeVersion {
  id          String     @id @default(uuid())
  typeKey     String
  type        ObjectType @relation(fields: [typeKey], references: [key], onDelete: Cascade)
  version     Int
  defHash     String
  definition  Json
  /// 칸 숨김 · 선택지 숨김 · 필수로 바꿈 · maxLength 줄임
  breaking    Boolean    @default(false)
  summary     String
  publishedAt DateTime   @default(now())

  @@unique([typeKey, version])
}
