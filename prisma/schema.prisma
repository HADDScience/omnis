generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── 사용자 ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @unique
  email        String?
  position     String?  // 직급 (예: 대표, 상무, 팀장, 과장, 사원)
  department   String?  // 부서 (예: 연구개발팀, AI개발팀)
  role         Role     @default(MEMBER)
  passwordHash String
  isActive        Boolean  @default(true)
  workspaceLayout Json?
  createdAt       DateTime @default(now())

  assignedTasks   Task[]          @relation("TaskOwner")
  instructedTasks Task[]          @relation("TaskInstructor")
  chatMessages    ChatMessage[]
  checklists      Checklist[]
  weeklyReports   WeeklyReport[]
  omnisUpdates    OmnisCard[]
  omnisVersions    OmnisCardVersion[]
  omnisQueries    OmnisQuery[]
  notifications   Notification[]
  omnisViewLogs   OmnisViewLog[]
  bookmarks       Bookmark[]
  activityLogs    ActivityLog[]
  geminiUsages    GeminiUsage[]
  aiDraftRevisions AiDraftRevision[]
}

enum Role {
  ADMIN
  MEMBER
}

// ─── 채팅 ────────────────────────────────────────────────

model ChatRoom {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id                String   @id @default(uuid())
  roomId            String
  room              ChatRoom @relation(fields: [roomId], references: [id])
  authorId          String
  author            User     @relation(fields: [authorId], references: [id])
  content           String
  taskId            String?
  task              Task?    @relation(fields: [taskId], references: [id])
  isTaskInstruction Boolean  @default(false)
  kind              MessageKind @default(NORMAL)
  createdAt         DateTime @default(now())

  files    File[]
  mentions ChatMention[]

  @@index([roomId, createdAt])
  @@index([taskId])
}

enum MessageKind {
  NORMAL
  TASK_CREATED
  TASK_REBUILT
  TASK_DONE
  /// 완료로 보이지만 담당자 확인을 기다리는 상태. TASK_DONE 과 구분해야
  /// 활동 요약에 "완료"라고 잘못 적히지 않는다.
  TASK_DONE_PENDING
}

model ChatMention {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MentionType
  taskId    String?
  userId    String?
  createdAt DateTime    @default(now())

  @@index([type, taskId])
  @@index([type, userId])
  @@index([messageId])
}

enum MentionType {
  TASK
  USER
}

// ─── 업무 ────────────────────────────────────────────────

model Task {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  ownerId        String
  owner          User       @relation("TaskOwner", fields: [ownerId], references: [id])
  instructorId   String
  instructor     User       @relation("TaskInstructor", fields: [instructorId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  /// @deprecated 2026-05-06 (Phase 2 #12) — UI/AI에서 제거됨. Phase 4에 컬럼 drop 예정.
  categoryId     String?
  /// @deprecated Phase 2 #12 — Phase 4에 관계 drop 예정.
  category       TaskCategory? @relation(fields: [categoryId], references: [id])
  status         TaskStatus    @default(TODO)
  priority       Priority   @default(NORMAL)
  background     String?
  expectedResult String?
  deadline       DateTime?
  workStart      DateTime?
  workEnd        DateTime?
  archived       Boolean    @default(false)
  notionId       String?
  sourceMessages Json?

  checklists Checklist[]
  messages   ChatMessage[]
  files      File[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ownerId, status])
  @@index([projectId])
  @@index([productId])
  @@index([categoryId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

// ─── 체크리스트 ──────────────────────────────────────────

model Checklist {
  id        String   @id @default(uuid())
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  done      Boolean  @default(false)
  memo      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─── 제품 ────────────────────────────────────────────────

model Product {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String
  sortOrder Int       @default(0)
  projects  Project[]
  tasks     Task[]
}

// ─── 업무 카테고리 (업무 유형) ────────────────────────────
// @deprecated Phase 2 #12 (2026-05-06) — UI/AI에서 폐기됨. Phase 4에 모델 drop 예정.
// 사용자 결정 Q1=A: "이유 없으면 지우자". 다수결로 활용 안이 채택됐으나 사용자 비전 우선.

model TaskCategory {
  id        String @id @default(uuid())
  name      String @unique
  icon      String?
  color     String?
  sortOrder Int    @default(0)
  tasks     Task[]
}

// ─── 프로젝트 ────────────────────────────────────────────

model Project {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("진행 중")
  priority  Priority  @default(NORMAL)
  purpose   String?
  goal      String?
  startDate DateTime?
  deadline  DateTime?
  archived  Boolean   @default(false)
  notionId  String?
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─── 주간 업무보고 ───────────────────────────────────────

model WeeklyReport {
  id        String   @id @default(uuid())
  title     String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  weekStart DateTime
  weekEnd   DateTime
  isoWeek   String
  status    String   @default("작성 중")
  submittedAt DateTime?
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, weekStart])
  @@unique([ownerId, isoWeek])
}

// ─── 옴니스 지식 베이스 ──────────────────────────────────

model OmnisCategory {
  id        String      @id @default(uuid())
  name      String      @unique
  icon      String?
  sortOrder Int         @default(0)
  cards     OmnisCard[]
}

model OmnisCard {
  id          String        @id @default(uuid())
  categoryId  String
  category    OmnisCategory @relation(fields: [categoryId], references: [id])
  title       String
  content     Json
  tags        String[]
  version     Int           @default(1)
  updatedById String?
  updatedBy   User?         @relation(fields: [updatedById], references: [id])
  versions    OmnisCardVersion[]
  viewLogs    OmnisViewLog[]
  bookmarks   Bookmark[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
}

model OmnisCardVersion {
  id               String    @id @default(uuid())
  cardId           String
  card             OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content          Json
  version          Int
  restoredFromHash String?
  createdById      String?
  createdBy        User?     @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())

  @@index([cardId, version])
  @@index([createdById])
}

// 옴니스 RAG 질문·답변 내역 (사용자별)
model OmnisQuery {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  /// 답변 근거 출처 배열 [{ id, source, sourceId, title, sourceLabel, similarity }]
  sources   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OmnisViewLog {
  id        String    @id @default(uuid())
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  viewedAt  DateTime  @default(now())

  @@index([cardId, viewedAt])
  @@index([userId, viewedAt])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, cardId])
  @@index([userId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// ─── 파일 ────────────────────────────────────────────────

model File {
  id        String       @id @default(uuid())
  name      String
  path      String
  size      Int
  mimeType  String
  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id])
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id])
  createdAt DateTime     @default(now())
}

// ─── Gemini 토큰 사용 로그 ───────────────────────────────

model GeminiUsage {
  id              String   @id @default(uuid())
  endpoint        String
  promptTokens    Int
  candidateTokens Int
  totalTokens     Int
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── 알림 ────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  content   String?
  entityId  String?
  read      Boolean  @default(false)
  /// 사용자의 명시적 응답이 필요한 알림의 종류. null이면 단순 통보.
  /// 값은 lib/schemas/notification.ts 의 NotificationActionSchema 와 일치해야 한다.
  actionType String?
  /// 액션에 응답한 시각. actionType != null && resolvedAt == null 이면 미해결 —
  /// 응답 전까지 삭제되지 않고 목록에 남는다.
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, actionType, resolvedAt])
}

// ─── 임베딩 (pgvector 벡터 검색) ─────────────────────────
// 옴니스 카드·업무·주간보고·채팅을 청크 단위로 임베딩해 RAG 검색에 사용.
// embedding 컬럼은 Prisma 미지원 타입이라 raw SQL(lib/embeddings.ts)로 read/write.

enum EmbeddingSource {
  OMNIS_CARD
  TASK
  WEEKLY_REPORT
  CHAT_MESSAGE
}

model EmbeddingChunk {
  id          String          @id @default(uuid())
  source      EmbeddingSource
  sourceId    String
  chunkIndex  Int             @default(0)
  title       String
  content     String
  contentHash String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([source, sourceId, chunkIndex])
  @@index([source, sourceId])
}

/// 업무 초안을 자연어 지시로 고친 기록.
///
/// "담당자는 혜린님으로, 마감은 다음주" 같은 지시와 그 전후 값을 남긴다.
/// 사람이 AI의 어떤 판단을 어떻게 되돌리는지가 쌓이는 자리다.
/// 지금은 **보관만** 한다 — 읽는 화면은 아직 없다.
model AiDraftRevision {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// 초안의 출발점이 된 원문 (슬래시 명령 등). 없을 수 있다.
  source String?
  /// 사용자가 자연어로 준 수정 지시
  instruction String
  /// 지시 직전의 폼 값 (TaskDraftSnapshotSchema 형태)
  before Json
  /// AI가 돌려준 결과 (적용 전 원본, TaskAiDraftSchema 형태)
  after Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
