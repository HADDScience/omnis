generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── 사용자 ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @unique
  email        String?
  position     String?  // 직급 (예: 대표, 상무, 팀장, 과장, 사원)
  department   String?  // 부서 (예: 연구개발팀, AI개발팀)
  role         Role     @default(MEMBER)
  passwordHash String
  isActive        Boolean  @default(true)
  workspaceLayout Json?
  createdAt       DateTime @default(now())

  assignedTasks   Task[]          @relation("TaskOwner")
  instructedTasks Task[]          @relation("TaskInstructor")
  chatMessages    ChatMessage[]
  checklists      Checklist[]
  weeklyReports   WeeklyReport[]
  omnisUpdates    OmnisCard[]
  omnisVersions    OmnisCardVersion[]
  omnisQueries    OmnisQuery[]
  notifications   Notification[]
  omnisViewLogs   OmnisViewLog[]
  bookmarks       Bookmark[]
  activityLogs    ActivityLog[]
  geminiUsages    GeminiUsage[]
  identities      UserIdentity[]
}

enum Role {
  ADMIN
  MEMBER
}

// ─── 채팅 ────────────────────────────────────────────────

/// 자체 계정(User)에 얹는 소셜 로그인 수단.
///
/// 계정의 주인은 언제나 User 다. 소셜은 "그 계정으로 들어오는 또 하나의 문"일 뿐이라,
/// 제공자가 서비스를 접거나 회사가 도구를 바꿔도 계정과 업무 데이터는 그대로 남는다.
///
/// 소셜 이메일로 사람을 짐작해 묶지 않는다 — 개인 지메일·카카오 이메일은 회사 계정과
/// 다르고, 카카오는 이메일 제공이 선택 동의라 아예 없을 수도 있다. 대신 **이미 로그인해
/// 계정 소유를 증명한 세션**에서만 연결을 허용한다. 남의 계정에 붙이려면 그 사람의
/// 세션이 필요하므로 원리적으로 막힌다.
model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google" | "kakao"
  provider          String
  /// 제공자가 발급한 불변 식별자 (구글 sub, 카카오 회원번호)
  providerAccountId String
  /// 화면에 "어느 계정과 연결됐는지" 보여주기 위한 참고값. 매칭에는 쓰지 않는다.
  email             String?
  createdAt         DateTime @default(now())

  /// 한 소셜 계정은 한 사람에게만 붙는다
  @@unique([provider, providerAccountId])
  /// 한 사람이 같은 제공자를 두 번 붙일 수 없다
  @@unique([userId, provider])
  @@index([userId])
}

model ChatRoom {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id                String   @id @default(uuid())
  roomId            String
  room              ChatRoom @relation(fields: [roomId], references: [id])
  authorId          String
  author            User     @relation(fields: [authorId], references: [id])
  content           String
  taskId            String?
  task              Task?    @relation(fields: [taskId], references: [id])
  isTaskInstruction Boolean  @default(false)
  kind              MessageKind @default(NORMAL)
  createdAt         DateTime @default(now())

  files    File[]
  mentions ChatMention[]

  @@index([roomId, createdAt])
  @@index([taskId])
}

enum MessageKind {
  NORMAL
  TASK_CREATED
  TASK_REBUILT
  TASK_DONE
}

model ChatMention {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MentionType
  taskId    String?
  userId    String?
  createdAt DateTime    @default(now())

  @@index([type, taskId])
  @@index([type, userId])
  @@index([messageId])
}

enum MentionType {
  TASK
  USER
}

// ─── 업무 ────────────────────────────────────────────────

model Task {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  ownerId        String
  owner          User       @relation("TaskOwner", fields: [ownerId], references: [id])
  instructorId   String
  instructor     User       @relation("TaskInstructor", fields: [instructorId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  /// @deprecated 2026-05-06 (Phase 2 #12) — UI/AI에서 제거됨. Phase 4에 컬럼 drop 예정.
  categoryId     String?
  /// @deprecated Phase 2 #12 — Phase 4에 관계 drop 예정.
  category       TaskCategory? @relation(fields: [categoryId], references: [id])
  status         TaskStatus    @default(TODO)
  priority       Priority   @default(NORMAL)
  background     String?
  expectedResult String?
  deadline       DateTime?
  workStart      DateTime?
  workEnd        DateTime?
  archived       Boolean    @default(false)
  notionId       String?
  sourceMessages Json?

  checklists Checklist[]
  messages   ChatMessage[]
  files      File[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ownerId, status])
  @@index([projectId])
  @@index([productId])
  @@index([categoryId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

// ─── 체크리스트 ──────────────────────────────────────────

model Checklist {
  id        String   @id @default(uuid())
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  done      Boolean  @default(false)
  memo      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─── 제품 ────────────────────────────────────────────────

model Product {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String
  sortOrder Int       @default(0)
  projects  Project[]
  tasks     Task[]
}

// ─── 업무 카테고리 (업무 유형) ────────────────────────────
// @deprecated Phase 2 #12 (2026-05-06) — UI/AI에서 폐기됨. Phase 4에 모델 drop 예정.
// 사용자 결정 Q1=A: "이유 없으면 지우자". 다수결로 활용 안이 채택됐으나 사용자 비전 우선.

model TaskCategory {
  id        String @id @default(uuid())
  name      String @unique
  icon      String?
  color     String?
  sortOrder Int    @default(0)
  tasks     Task[]
}

// ─── 프로젝트 ────────────────────────────────────────────

model Project {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("진행 중")
  priority  Priority  @default(NORMAL)
  purpose   String?
  goal      String?
  startDate DateTime?
  deadline  DateTime?
  archived  Boolean   @default(false)
  notionId  String?
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─── 주간 업무보고 ───────────────────────────────────────

model WeeklyReport {
  id        String   @id @default(uuid())
  title     String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  weekStart DateTime
  weekEnd   DateTime
  isoWeek   String
  status    String   @default("작성 중")
  submittedAt DateTime?
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, weekStart])
  @@unique([ownerId, isoWeek])
}

// ─── 옴니스 지식 베이스 ──────────────────────────────────

model OmnisCategory {
  id        String      @id @default(uuid())
  name      String      @unique
  icon      String?
  sortOrder Int         @default(0)
  cards     OmnisCard[]
}

model OmnisCard {
  id          String        @id @default(uuid())
  categoryId  String
  category    OmnisCategory @relation(fields: [categoryId], references: [id])
  title       String
  content     Json
  tags        String[]
  version     Int           @default(1)
  updatedById String?
  updatedBy   User?         @relation(fields: [updatedById], references: [id])
  versions    OmnisCardVersion[]
  viewLogs    OmnisViewLog[]
  bookmarks   Bookmark[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
}

model OmnisCardVersion {
  id               String    @id @default(uuid())
  cardId           String
  card             OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content          Json
  version          Int
  restoredFromHash String?
  createdById      String?
  createdBy        User?     @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())

  @@index([cardId, version])
  @@index([createdById])
}

// 옴니스 RAG 질문·답변 내역 (사용자별)
model OmnisQuery {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  /// 답변 근거 출처 배열 [{ id, source, sourceId, title, sourceLabel, similarity }]
  sources   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OmnisViewLog {
  id        String    @id @default(uuid())
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  viewedAt  DateTime  @default(now())

  @@index([cardId, viewedAt])
  @@index([userId, viewedAt])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, cardId])
  @@index([userId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// ─── 파일 ────────────────────────────────────────────────

model File {
  id        String       @id @default(uuid())
  name      String
  path      String
  size      Int
  mimeType  String
  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id])
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id])
  createdAt DateTime     @default(now())
}

// ─── Gemini 토큰 사용 로그 ───────────────────────────────

model GeminiUsage {
  id              String   @id @default(uuid())
  endpoint        String
  promptTokens    Int
  candidateTokens Int
  totalTokens     Int
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── 알림 ────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  content   String?
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── 임베딩 (pgvector 벡터 검색) ─────────────────────────
// 옴니스 카드·업무·주간보고·채팅을 청크 단위로 임베딩해 RAG 검색에 사용.
// embedding 컬럼은 Prisma 미지원 타입이라 raw SQL(lib/embeddings.ts)로 read/write.

enum EmbeddingSource {
  OMNIS_CARD
  TASK
  WEEKLY_REPORT
  CHAT_MESSAGE
  /// 지식재산권 건 (상표·특허). sourceId 는 "trademark:TM-01" 꼴.
  IP_CASE
}

model EmbeddingChunk {
  id          String          @id @default(uuid())
  source      EmbeddingSource
  sourceId    String
  chunkIndex  Int             @default(0)
  title       String
  content     String
  contentHash String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([source, sourceId, chunkIndex])
  @@index([source, sourceId])
}

// ─── SSO (사내 도구 통합 로그인) ─────────────────────────────────────

/// 발급된 SSO grant 의 사용 기록. 1회용을 강제하는 것이 유일한 목적이다.
///
/// jti 를 PK 로 두고 INSERT 를 시도하는 것 자체가 검사다 — 두 번째 INSERT 는
/// 유니크 위반으로 튕긴다. 메모리 캐시로는 서버리스 인스턴스가 여러 개일 때
/// 같은 표가 두 번 통과할 수 있어 DB 로 못박는다.
///
/// 만료된 행은 재사용 판정에 쓸모가 없어 가끔 청소한다 (lib/sso.ts consumeGrant).
model SsoGrant {
  /// 토큰의 jti 클레임
  jti       String   @id
  /// 어느 앱용으로 끊은 표인가 (토큰의 audience)
  appId     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
