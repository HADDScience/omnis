generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── 사용자 ──────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  name            String   @unique
  email           String?
  position        String? // 직급 (예: 대표, 상무, 팀장, 과장, 사원)
  department      String? // 부서 (예: 연구개발팀, AI개발팀)
  role            Role     @default(MEMBER)
  passwordHash    String
  isActive        Boolean  @default(true)
  onboardingVideoSeenAt DateTime?
  onboardingCompletedAt DateTime?
  workspaceLayout Json?
  createdAt       DateTime @default(now())

  assignedTasks    TaskAssignee[]
  instructedTasks  Task[]             @relation("TaskInstructor")
  chatMessages     ChatMessage[]
  weeklyReports    WeeklyReport[]
  omnisUpdates     OmnisCard[]
  omnisVersions    OmnisCardVersion[]
  cardDecisions    CardProposal[]
  omnisQueries     OmnisQuery[]
  notifications    Notification[]
  omnisViewLogs    OmnisViewLog[]
  bookmarks        Bookmark[]
  activityLogs     ActivityLog[]
  geminiUsages     GeminiUsage[]
  identities       UserIdentity[]
  aiDraftRevisions AiDraftRevision[]
  staffProfile     StaffProfile?
}

enum Role {
  ADMIN
  MEMBER
}

// ─── 채팅 ────────────────────────────────────────────────

/// 자체 계정(User)에 얹는 소셜 로그인 수단.
///
/// 계정의 주인은 언제나 User 다. 소셜은 "그 계정으로 들어오는 또 하나의 문"일 뿐이라,
/// 제공자가 서비스를 접거나 회사가 도구를 바꿔도 계정과 업무 데이터는 그대로 남는다.
///
/// 소셜 이메일로 사람을 짐작해 묶지 않는다 — 개인 지메일·카카오 이메일은 회사 계정과
/// 다르고, 카카오는 이메일 제공이 선택 동의라 아예 없을 수도 있다. 대신 **이미 로그인해
/// 계정 소유를 증명한 세션**에서만 연결을 허용한다. 남의 계정에 붙이려면 그 사람의
/// 세션이 필요하므로 원리적으로 막힌다.
model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "google" | "kakao"
  provider          String
  /// 제공자가 발급한 불변 식별자 (구글 sub, 카카오 회원번호)
  providerAccountId String
  /// 화면에 "어느 계정과 연결됐는지" 보여주기 위한 참고값. 매칭에는 쓰지 않는다.
  email             String?
  createdAt         DateTime @default(now())

  /// 한 소셜 계정은 한 사람에게만 붙는다
  @@unique([provider, providerAccountId])
  /// 한 사람이 같은 제공자를 두 번 붙일 수 없다
  @@unique([userId, provider])
  @@index([userId])
}

model ChatRoom {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id                String      @id @default(uuid())
  /// 외부에서 들여온 원본 식별자. 카톡 이식은 "kakao:<sha1>" 형태.
  /// 이식을 여러 번 돌려도 중복이 생기지 않게 하는 유일한 장치다.
  sourceId          String?     @unique
  roomId            String
  room              ChatRoom    @relation(fields: [roomId], references: [id])
  authorId          String
  author            User        @relation(fields: [authorId], references: [id])
  content           String
  taskId            String?
  task              Task?       @relation(fields: [taskId], references: [id])
  isTaskInstruction Boolean     @default(false)
  kind              MessageKind @default(NORMAL)
  createdAt         DateTime    @default(now())
  /// 고친 시각. null 이면 보낸 그대로다.
  editedAt          DateTime?
  /// 지운 시각. 행은 지우지 않는다 — 답장이 가리키는 글 · 업무 연결 · 색인이 함께 사라지기 때문이다.
  /// 본문은 그대로 두고 API 가 내려보내지 않는다.
  deletedAt         DateTime?
  /// 답장 대상. 지워진 글에도 답장이 달려 있을 수 있어 행을 남긴다.
  replyToId         String?
  replyTo           ChatMessage?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies           ChatMessage[] @relation("MessageReply")

  files    File[]
  mentions ChatMention[]

  @@index([roomId, createdAt])
  @@index([taskId])
  @@index([replyToId])
}

enum MessageKind {
  NORMAL
  TASK_CREATED
  TASK_REBUILT
  TASK_DONE
  /// 완료로 보이지만 담당자 확인을 기다리는 상태. TASK_DONE 과 구분해야
  /// 활동 요약에 "완료"라고 잘못 적히지 않는다.
  TASK_DONE_PENDING
}

model ChatMention {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MentionType
  taskId    String?
  userId    String?
  createdAt DateTime    @default(now())

  @@index([type, taskId])
  @@index([type, userId])
  @@index([messageId])
}

enum MentionType {
  TASK
  USER
}

// ─── 업무 ────────────────────────────────────────────────

model Task {
  id             String         @id @default(uuid())
  /// 외부에서 들여온 원본 식별자. 카톡 이식은 "kakao-session:<세션id>" 형태.
  sourceId       String?        @unique
  name           String
  slug           String         @unique
  /// 담당자. 한 업무를 여러 명이 함께 맡을 수 있다 (예: "인턴들 각자 ~해주세요").
  assignees      TaskAssignee[]
  instructorId   String
  instructor     User           @relation("TaskInstructor", fields: [instructorId], references: [id])
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  /// @deprecated 2026-05-06 (Phase 2 #12) — UI/AI에서 제거됨. Phase 4에 컬럼 drop 예정.
  categoryId     String?
  /// @deprecated Phase 2 #12 — Phase 4에 관계 drop 예정.
  category       TaskCategory?  @relation(fields: [categoryId], references: [id])
  status         TaskStatus     @default(TODO)
  priority       Priority       @default(NORMAL)
  background     String?
  expectedResult String?
  deadline       DateTime?
  workStart      DateTime?
  workEnd        DateTime?
  archived       Boolean        @default(false)
  notionId       String?
  sourceMessages Json?

  checklists    Checklist[]
  messages      ChatMessage[]
  files         File[]
  cardProposals CardProposal[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([productId])
  @@index([categoryId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

// ─── 체크리스트 ──────────────────────────────────────────

/// 업무 담당자 (다대다).
///
/// 카톡 이력을 보면 "인턴들 각자 증명사진 보내주세요"처럼 한 번의 지시가 여러 명에게
/// 향하는 경우가 흔하다. 담당자를 하나만 담으면 이런 지시를 업무로 만들 수 없거나,
/// 사람 수만큼 카드를 쪼개 실제보다 지시가 많았던 것처럼 왜곡된다.
///
/// 체크리스트는 사람별로 나누지 않는다. 지시 하나에 목록 하나여야 지시한 사람도
/// 받은 사람도 무엇이 남았는지 같은 화면에서 본다.
model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model Checklist {
  id        String   @id @default(uuid())
  name      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  done      Boolean  @default(false)
  memo      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ─── 제품 ────────────────────────────────────────────────

model Product {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String
  sortOrder Int       @default(0)
  projects  Project[]
  tasks     Task[]
}

// ─── 업무 카테고리 (업무 유형) ────────────────────────────
// @deprecated Phase 2 #12 (2026-05-06) — UI/AI에서 폐기됨. Phase 4에 모델 drop 예정.
// 사용자 결정 Q1=A: "이유 없으면 지우자". 다수결로 활용 안이 채택됐으나 사용자 비전 우선.

model TaskCategory {
  id        String  @id @default(uuid())
  name      String  @unique
  icon      String?
  color     String?
  sortOrder Int     @default(0)
  tasks     Task[]
}

// ─── 프로젝트 ────────────────────────────────────────────

model Project {
  id        String    @id @default(uuid())
  name      String
  status    String    @default("진행 중")
  priority  Priority  @default(NORMAL)
  purpose   String?
  goal      String?
  startDate DateTime?
  deadline  DateTime?
  archived  Boolean   @default(false)
  notionId  String?
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])

  tasks     Task[]
  records   CompanyRecord[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([productId])
}

// ─── 주간 업무보고 ───────────────────────────────────────

model WeeklyReport {
  id          String    @id @default(uuid())
  title       String
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  weekStart   DateTime
  weekEnd     DateTime
  isoWeek     String
  status      String    @default("작성 중")
  submittedAt DateTime?
  content     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, isoWeek])
  @@index([ownerId, weekStart])
}

// ─── 옴니스 지식 베이스 ──────────────────────────────────

model OmnisCategory {
  id        String         @id @default(uuid())
  name      String         @unique
  icon      String?
  sortOrder Int            @default(0)
  cards     OmnisCard[]
  proposals CardProposal[]
}

model OmnisCard {
  id          String             @id @default(uuid())
  categoryId  String
  category    OmnisCategory      @relation(fields: [categoryId], references: [id])
  title       String
  content     Json
  tags        String[]
  version     Int                @default(1)
  updatedById String?
  updatedBy   User?              @relation(fields: [updatedById], references: [id])
  /// 이 카드의 근거. [{ kind: "task"|"message", id, label }] — AI 가 쓴 내용은 근거 없이 남기지 않는다.
  sourceRefs  Json?
  /// AI 가 마지막으로 반영한 시각. 사람이 고치면 그대로 두고 updatedAt 만 움직인다.
  aiUpdatedAt DateTime?
  versions    OmnisCardVersion[]
  viewLogs    OmnisViewLog[]
  bookmarks   Bookmark[]
  proposals   CardProposal[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId])
}

model OmnisCardVersion {
  id               String         @id @default(uuid())
  cardId           String
  card             OmnisCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  content          Json
  version          Int
  restoredFromHash String?
  createdById      String?
  createdBy        User?          @relation(fields: [createdById], references: [id])
  /// 이 판을 누가 썼나. AI 가 쓴 문장을 사람이 쓴 문장과 구분한다 (충돌 시 사람이 이긴다).
  authorKind       CardAuthorKind @default(HUMAN)
  createdAt        DateTime       @default(now())

  @@index([cardId, version])
  @@index([createdById])
}

enum CardAuthorKind {
  HUMAN
  AI
}

enum CardProposalStatus {
  /// 사람의 판단을 기다린다
  PENDING
  /// 사람이 수락해 카드에 반영됐다
  ACCEPTED
  /// 사람이 거절했다
  REJECTED
  /// 수락률이 임계치를 넘어 사람 확인 없이 반영됐다
  AUTO_APPLIED
  /// 같은 카드에 더 새로운 제안이 와서 밀렸다
  SUPERSEDED
}

/// AI 가 만든 지식 카드 갱신 제안.
///
/// 사람이 카드를 직접 쓰는 구조로는 한 번도 채워지지 않았다(카드 0장·조회 0).
/// 그래서 AI 가 업무 중 생긴 변화를 제안으로 올리고, 사람이 수락·거절한다.
/// 수락이 꾸준히 많으면 `shouldAutoApply()` 가 자동 적용으로 넘긴다 — lib/card-proposals.ts.
///
/// 배경: mydocs/plans/2026-09-10-ai-maintained-cards.md
model CardProposal {
  id     String             @id @default(uuid())
  status CardProposalStatus @default(PENDING)

  /// 기존 카드를 고치는 제안이면 그 카드. 새 카드 제안이면 null
  cardId     String?
  /// 카드가 지워져도 제안은 남는다 — 이 표가 수락률의 근거라 판단 기록을 잃으면 안 된다.
  card       OmnisCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /// 새 카드 제안일 때 들어갈 분류
  categoryId String?
  category   OmnisCategory? @relation(fields: [categoryId], references: [id])

  title      String
  /// 제안하는 카드 본문 전체 (CardContent 형태 — 통째로 다시 쓴다, 증분이 아니다)
  content    Json
  /// 왜 이렇게 바꾸는지 한 줄
  reason     String
  /// 근거 [{ kind, id, label }]. 비어 있으면 만들지 않는다
  sourceRefs Json

  /// 무엇이 이 제안을 불렀나 — task_done · weekly · manual · seed
  trigger       String
  triggerTaskId String?
  triggerTask   Task?   @relation(fields: [triggerTaskId], references: [id], onDelete: SetNull)

  decidedById String?
  decidedBy   User?     @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime?
  /// 되돌린 시각. 자동 적용된 것을 사람이 되돌리면 수락률에 거절로 반영된다
  revertedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([cardId])
  @@index([triggerTaskId])
}

// 옴니스 RAG 질문·답변 내역 (사용자별)
model OmnisQuery {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  answer    String
  /// 답변 근거 출처 배열 [{ id, source, sourceId, title, sourceLabel, similarity }]
  sources   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OmnisViewLog {
  id       String    @id @default(uuid())
  cardId   String
  card     OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?     @relation(fields: [userId], references: [id])
  viewedAt DateTime  @default(now())

  @@index([cardId, viewedAt])
  @@index([userId, viewedAt])
}

model Bookmark {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      OmnisCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, cardId])
  @@index([userId, createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  title     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// ─── 파일 ────────────────────────────────────────────────

model File {
  id        String       @id @default(uuid())
  name      String
  path      String
  size      Int
  mimeType  String
  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id])
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id])
  createdAt DateTime     @default(now())
}

// ─── Gemini 토큰 사용 로그 ───────────────────────────────

model GeminiUsage {
  id              String   @id @default(uuid())
  endpoint        String
  promptTokens    Int
  candidateTokens Int
  totalTokens     Int
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ─── 알림 ────────────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  title      String
  content    String?
  entityId   String?
  read       Boolean   @default(false)
  /// 사용자의 명시적 응답이 필요한 알림의 종류. null이면 단순 통보.
  /// 값은 lib/schemas/notification.ts 의 NotificationActionSchema 와 일치해야 한다.
  actionType String?
  /// 액션에 응답한 시각. actionType != null && resolvedAt == null 이면 미해결 —
  /// 응답 전까지 삭제되지 않고 목록에 남는다.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, actionType, resolvedAt])
}

// ─── 임베딩 (pgvector 벡터 검색) ─────────────────────────
// 옴니스 카드·업무·주간보고·채팅을 청크 단위로 임베딩해 RAG 검색에 사용.
// embedding 컬럼은 Prisma 미지원 타입이라 raw SQL(lib/embeddings.ts)로 read/write.

enum EmbeddingSource {
  OMNIS_CARD
  TASK
  WEEKLY_REPORT
  CHAT_MESSAGE
  /// 지식재산권 건 (상표·특허). sourceId 는 "trademark:TM-01" 꼴.
  IP_CASE
}

model EmbeddingChunk {
  id          String                      @id @default(uuid())
  source      EmbeddingSource
  sourceId    String
  chunkIndex  Int                         @default(0)
  title       String
  content     String
  contentHash String
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([source, sourceId, chunkIndex])
  @@index([source, sourceId])
}

// ─── SSO (사내 도구 통합 로그인) ─────────────────────────────────────

/// 발급된 SSO grant 의 사용 기록. 1회용을 강제하는 것이 유일한 목적이다.
///
/// jti 를 PK 로 두고 INSERT 를 시도하는 것 자체가 검사다 — 두 번째 INSERT 는
/// 유니크 위반으로 튕긴다. 메모리 캐시로는 서버리스 인스턴스가 여러 개일 때
/// 같은 표가 두 번 통과할 수 있어 DB 로 못박는다.
///
/// 만료된 행은 재사용 판정에 쓸모가 없어 가끔 청소한다 (lib/sso.ts consumeGrant).
model SsoGrant {
  /// 토큰의 jti 클레임
  jti       String   @id
  /// 어느 앱용으로 끊은 표인가 (토큰의 audience)
  appId     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// 업무 초안을 자연어 지시로 고친 기록.
///
/// "담당자는 혜린님으로, 마감은 다음주" 같은 지시와 그 전후 값을 남긴다.
/// 사람이 AI의 어떤 판단을 어떻게 되돌리는지가 쌓이는 자리다.
/// 지금은 **보관만** 한다 — 읽는 화면은 아직 없다.
model AiDraftRevision {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// 초안의 출발점이 된 원문 (슬래시 명령 등). 없을 수 있다.
  source      String?
  /// 사용자가 자연어로 준 수정 지시
  instruction String
  /// 지시 직전의 폼 값 (TaskDraftSnapshotSchema 형태)
  before      Json
  /// AI가 돌려준 결과 (적용 전 원본, TaskAiDraftSchema 형태)
  after       Json

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── CRM ─────────────────────────────────────────────────
//
// 엑셀 HADDScience_CRM_260527.xlsx 를 대체한다. 모델 이름에 Crm 을 붙이는 이유는
// Product 가 이미 업무 분류용으로 쓰이고 있고, Org·Contact·Quote 는 앞으로도
// 부딪히기 쉬운 이름이기 때문이다.
//
// 엑셀이 문자열(기관명·담당자명)로 시트를 잇던 것을 전부 FK 로 바꿨다. 그래서
// "담당자명에 직함을 쓰지 말라"는 규칙이 사라진다 — 직함은 별도 칸이다.

enum CrmOrgType {
  UNIVERSITY // 대학
  RESEARCH // 연구원
  COMPANY // 기업
  HOSPITAL // 병원
  OTHER
}

enum CrmMembershipStatus {
  ACTIVE // 활성
  INACTIVE // 해지
}

enum CrmQuoteStatus {
  DRAFT // 작성중
  SENT // 발송
  DONE // 완료
  CANCELLED // 취소
}

model CrmOrg {
  id        String     @id @default(uuid())
  code      String     @unique // ORG001 — 엑셀 기관코드를 그대로 이어받는다
  name      String     @unique
  type      CrmOrgType @default(OTHER)
  /// 사업자등록번호 — 세금계산서의 공급받는자를 기관에 잇는 열쇠
  bizRegNo  String?    @unique
  address   String?
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  contacts       CrmContact[]
  memberships    CrmMembership[]
  quotes         CrmQuote[]
  sampleRequests CrmSampleRequest[]
  shipments      CrmShipment[]
  taxInvoices    TaxInvoice[]

  @@index([name])
}

model CrmContact {
  id    String  @id @default(uuid())
  code  String  @unique // CT001
  orgId String
  org   CrmOrg  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String
  /// 교수·소장·박사 등. 엑셀에서는 이름에 붙이면 매칭이 깨져 금지했지만 여기서는 별개다.
  title String?
  phone String?
  email String?
  note  String?

  memberships    CrmMembership[]
  quotes         CrmQuote[]
  sampleRequests CrmSampleRequest[]

  @@index([orgId])
  @@index([name])
}

/// HRP Membership. 활성이면 견적에서 할인을 제안한다 — 강제하지는 않는다.
model CrmMembership {
  id             String              @id @default(uuid())
  code           String              @unique // HRP260001
  orgId          String
  org            CrmOrg              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        CrmContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status         CrmMembershipStatus @default(ACTIVE)
  discountAmount Int                 @default(400000)
  createdAt      DateTime            @default(now())

  quotes CrmQuote[]

  @@index([orgId])
}

model CrmProduct {
  id               String       @id @default(uuid())
  code             String       @unique // PRD001
  name             String
  spec             String? // 규격 — 5ml, 1ml, 5g …
  kind             String? // 타입 — 시린지 / 바이알 / 원료 / 세트 …
  /// 기준 단가. 견적에는 이 값이 **복사**되어 굳는다. 여기를 고쳐도 지난 견적은 변하지 않는다.
  unitPrice        Int?
  /// 원료(DNA 등)는 판매 품목이 아니라 재고 대상이다.
  isMaterial       Boolean      @default(false)
  /// 이 품목을 무엇으로 세는가. 원료는 그램, 완제품은 개.
  stockUnit        CrmStockUnit @default(PIECE)
  /// 완제품 한 개의 용량(ml). 생산에 드는 원료량을 계산할 때 쓴다.
  volumeMl         Decimal?     @db.Decimal(10, 3)
  /// 농도(wt%). 1wt% = 1ml 당 0.01g.
  /// 애드젤이 1wt% 다. 모르는 품목은 비워 두고, 비어 있으면 소요량을 계산하지 않는다 —
  /// 숫자를 지어내느니 계산을 안 하는 편이 낫다.
  concentrationPct Decimal?     @db.Decimal(6, 3)
  note             String?
  archived         Boolean      @default(false)

  quoteItems        CrmQuoteItem[]
  sampleRequests    CrmSampleRequest[]
  shipments         CrmShipment[]
  stockMoves        CrmStockMove[]
  productions       CrmProduction[]    @relation("ProducedProduct")
  usedInProductions CrmProduction[]    @relation("ProductionMaterial")
  invoiceItems      TaxInvoiceItem[]

  @@unique([name, spec])
}

model CrmQuote {
  id        String      @id @default(uuid())
  code      String      @unique // HADD240924-001
  quotedAt  DateTime
  orgId     String
  org       CrmOrg      @relation(fields: [orgId], references: [id])
  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  membershipId   String?
  membership     CrmMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  /// **실제로 깎인 금액.** 엑셀에는 회원이면 400,000 이 자동으로 적혔지만 13건 중 8건은
  /// 소계에서 빠지지 않았다(단가에 녹인 것으로 보인다). 여기에는 실제 적용액만 담는다.
  discountAmount Int            @default(0)

  vatRate       Int            @default(10) // %
  status        CrmQuoteStatus @default(DRAFT)
  taxInvoicedAt DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items       CrmQuoteItem[]
  shipments   CrmShipment[]
  taxInvoices TaxInvoice[]

  @@index([orgId])
  @@index([quotedAt])
}

model CrmQuoteItem {
  id        String     @id @default(uuid())
  quoteId   String
  quote     CrmQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String
  product   CrmProduct @relation(fields: [productId], references: [id])
  quantity  Int
  /// 견적 당시 단가의 사본. 제품 단가가 나중에 바뀌어도 지난 견적 금액은 그대로다.
  unitPrice Int
  note      String?
  sortOrder Int        @default(0)

  @@index([quoteId])
}

// ─── CRM — 샘플요청 · 출고 · 재고 ─────────────────────────

enum CrmSampleStatus {
  PENDING // 미발송
  SENT // 발송완료
}

enum CrmShipmentKind {
  SALE // 판매
  SAMPLE // 샘플
  GIFT // 증정
}

enum CrmShipmentStatus {
  PREPARING // 준비중
  SHIPPING // 배송중
  DELIVERED // 배송완료
}

/// 재고를 세는 단위. 원료는 g, 완제품은 개다.
/// 예전에는 원료도 "DNA 5g 15개" 처럼 개로 셌는데, 5g 병과 4.5g 병이 섞이면
/// 개수만으로는 몇 그램인지 알 수 없다. 생산에 쓰는 것은 그램이다.
enum CrmStockUnit {
  PIECE // 개
  GRAM // g
}

/// 재고 장부의 방향. 현재고 = Σ IN − Σ OUT 로만 구한다 — 어딘가에 적힌 숫자를
/// 믿지 않는다. 엑셀은 요약 칸을 따로 두고 출고를 "별도 관리" 해서 총 출고량이
/// 23건의 출고 기록이 있는데도 0 으로 남아 있었다.
enum CrmStockDirection {
  IN
  OUT
}

model CrmSampleRequest {
  id          String          @id @default(uuid())
  code        String          @unique // HADD251202-001
  requestedAt DateTime
  orgId       String
  org         CrmOrg          @relation(fields: [orgId], references: [id])
  contactId   String?
  contact     CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  productId   String?
  product     CrmProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 요청사항 원문. "라이브젤 샘플 및 카다로그 요청" 처럼 제품만으로는 안 담기는 말이 들어온다.
  request     String?
  /// 소개경로 — 학회·지인·QR·전화. 어디서 왔는지가 다음 영업의 단서다.
  referral    String?
  status      CrmSampleStatus @default(PENDING)
  sentAt      DateTime?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  shipments CrmShipment[]

  @@index([orgId])
  @@index([requestedAt])
}

model CrmShipment {
  id              String            @id @default(uuid())
  code            String            @unique // SH001
  shippedAt       DateTime
  kind            CrmShipmentKind   @default(SALE)
  orgId           String
  org             CrmOrg            @relation(fields: [orgId], references: [id])
  productId       String
  product         CrmProduct        @relation(fields: [productId], references: [id])
  quantity        Int
  status          CrmShipmentStatus @default(PREPARING)
  /// 어느 견적/샘플요청에서 나온 출고인지. 엑셀은 견적번호를 문자열로 적어 뒀다.
  quoteId         String?
  quote           CrmQuote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  sampleRequestId String?
  sampleRequest   CrmSampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  stockMoves CrmStockMove[]

  @@index([orgId])
  @@index([shippedAt])
}

/// 재고 장부 한 줄. 입고도 출고도 같은 표에 쌓는다.
///
/// 단위는 품목이 정한다(CrmProduct.stockUnit) — 원료면 g, 완제품이면 개.
/// 그램은 4.5 처럼 소수가 나오므로 정수로 두면 안 된다.
model CrmStockMove {
  id           String            @id @default(uuid())
  movedAt      DateTime
  productId    String
  product      CrmProduct        @relation(fields: [productId], references: [id])
  direction    CrmStockDirection
  quantity     Decimal           @db.Decimal(12, 3)
  note         String?
  /// 출고에서 파생된 줄이면 그 출고를 가리킨다. 사람이 직접 적은 줄은 비어 있다.
  shipmentId   String?
  shipment     CrmShipment?      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// 생산에서 파생된 줄. 한 번의 생산이 원료 OUT 과 완제품 IN 두 줄을 만든다.
  productionId String?
  production   CrmProduction?    @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([movedAt])
}

/// 생산 기록. 원료를 써서 완제품 몇 개를 만들었는지.
///
/// 이것이 원료와 완제품을 잇는 유일한 고리다. 이게 없으면 "DNA 를 썼는데 제품이
/// 어디서 왔는지" 를 아무도 모른 채 두 장부가 따로 논다 — 엑셀이 그랬다.
model CrmProduction {
  id            String     @id @default(uuid())
  code          String     @unique // MFG260904-001
  producedAt    DateTime
  /// 만든 것
  productId     String
  product       CrmProduct @relation("ProducedProduct", fields: [productId], references: [id])
  quantity      Int
  /// 쓴 원료
  materialId    String
  material      CrmProduct @relation("ProductionMaterial", fields: [materialId], references: [id])
  materialGrams Decimal    @db.Decimal(12, 3)
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  stockMoves CrmStockMove[]

  @@index([producedAt])
}

// ─── 홈페이지 기사 ──────────────────────────────────────────────
//
// haddscience.com 의 뉴스 기사. 예전에는 사이트 저장소에 JSON 으로 커밋했다(git 이 DB).
// 관리 화면이 Omnis SSO 로 옮겨 오면서 저장도 여기로 왔다 — 정적 사이트가 GitHub 토큰을
// 들 수 없어 서버가 대신 커밋해야 했는데, 그럴 바에는 DB 에 두는 편이 단순하다.
// content · deck 의 모양은 lib/schemas/website.ts 가 정한다 (사이트 content/types.ts 와 같다).

model WebsitePost {
  /// "20260827-1149"(관리 화면이 매김) 또는 아임웹 시절 숫자 id
  id           String   @id
  /// 목록 순서. 작을수록 위. 옛 order.json 을 대신한다
  position     Int
  /// 표시용 날짜 "2026.07.08"
  date         String
  /// 사람이 쓴 언어. 나머지는 여기서 번역된다
  sourceLang   String
  /// 목록 썸네일 URL. 언어 공통
  thumbnail    String?
  /// 외부에 원문이 있으면 그 주소
  externalHref String?
  /// { ko: PostLocale, en?: PostLocale }
  content      Json
  /// 카드뉴스 편집기로 만든 글이면 원본 덱
  deck         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@index([position])
}

/// 기사에 딸린 사진. 실물은 NAS(lib/storage.ts), 여기는 목록 — 기사를 지울 때 함께 지우기 위해서다.
/// postId 는 외래키가 아니다. 새 글은 사진을 먼저 올리고 글을 저장하므로 그 시점엔 기사 행이 없다.
/// 끝내 저장되지 않은 글의 사진은 고아로 남는데, 그건 정리 작업이 거둬 갈 몫이다.
model WebsiteMedia {
  id          String   @id @default(cuid())
  postId      String
  /// NAS 키 "website/<postId>/<id>.webp". 업로드마다 고유하므로 영구 캐시할 수 있다
  key         String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([postId])
}

// ─── 회사 Context (2026-09-14) ───────────────────────────────────────
//
// HADD DB 에서 모아 보는 회사 자료. 원본은 옴니스다 — 노션·엑셀은 한 번 옮기고 끝낸다.
// 설계: mydocs/plans/2026-09-14-company-context.md
// 세는 자료는 여기(모델), 읽는 서술은 지식 카드(AI 가 갱신), 파일은 NAS.

/// 회사 기본정보. 지원서에 글자 그대로 들어가는 값이라 AI 가 쓰지 않는다 — 카드와 다르다.
model CompanyProfile {
  id             String    @id @default("hadd")
  nameKo         String
  nameEn         String?
  bizRegNo       String
  /// 개인사업자 · 법인. 사업자번호(503-52-…)와 결산서로는 개인과세사업자 — 법인 전환 여부 확인 필요
  bizType        String?
  corpRegNo      String?
  industry       String?
  industryCode   String?
  foundedOn      DateTime?
  homepage       String?
  hqAddress      String?
  labAddress     String?
  partnerAddress String?
  asOfDate       DateTime?
  updatedById    String?
  updatedAt      DateTime  @updatedAt
}

enum FigureBasis {
  /// 확정 — 결산서(신고한 재무제표)
  CONFIRMED
  /// 계획 — 예상·추정. 사업계획서용이고 실적과 섞지 않는다
  PLANNED
}

/// 연도별 재무·인원. 금액은 원, 매출은 공급가액(부가세 제외).
/// 결산 전인 올해의 「잠정」 매출은 저장하지 않고 TaxInvoice 에서 매번 센다.
model CompanyYear {
  id                String      @id @default(uuid())
  year              Int
  basis             FigureBasis
  revenueKrw        BigInt?
  revenueProductKrw BigInt?
  revenueServiceKrw BigInt?
  costOfSalesKrw    BigInt?
  netIncomeKrw      BigInt?
  assetsKrw         BigInt?
  liabilitiesKrw    BigInt?
  equityKrw         BigInt?
  /// 상시근로자
  headcount         Int?
  /// 결산서의 매출 계정 이름 (상품매출 · 서비스수입 …) — 세무사 확인용
  accountLabel      String?
  note              String?
  /// 결산서 원본 (NAS 키)
  sourceFileKey     String?
  asOfDate          DateTime?
  updatedAt         DateTime    @updatedAt

  @@unique([year, basis])
}

enum EmploymentStatus {
  EMPLOYED
  FORMER
}

/// 인력 프로필. 과제 대리 작성에 쓴다. User 가 아닌 사람(외부 연구원)도 담는다.
/// 관리자만 연다. AI 도구에는 이름 · 소속 · 직책 · 담당업무만 싣는다.
model StaffProfile {
  id          String           @id @default(uuid())
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String           @unique
  /// 본 소속 — 하드사이언스 · 성균관대학교 · EAS
  affiliation String
  /// 본 소속에서의 직책
  position    String?
  /// 하드사이언스 겸직 직함 — CAO · CMO
  haddRole    String?
  employment  EmploymentStatus @default(EMPLOYED)
  /// 4대보험 가입
  insured     Boolean          @default(false)
  education   String?
  major       String?
  duties      String?
  /// 과학기술인번호 (NTIS)
  ntisNo      String?
  email       String?
  phone       String?
  birthDate   DateTime?
  joinedOn    DateTime?
  note        String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assets StaffAsset[]
}

enum StaffAssetKind {
  SIGNATURE
  SEAL
}

/// 서명 · 직인 이미지. 실물은 NAS(lib/storage), 여기엔 키만.
/// 복사 · 내려받기는 누가 · 언제 · 누구의 것을 활동 로그에 남긴다.
model StaffAsset {
  id        String         @id @default(uuid())
  staffId   String
  staff     StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind      StaffAssetKind
  objectKey String
  fileName  String
  mimeType  String
  width     Int?
  height    Int?
  size      Int
  createdAt DateTime       @default(now())

  @@index([staffId])
}

/// 시장 · 경쟁 기업. 거래처(CrmOrg)와 섞지 않는다 — 섞으면 「거래 기관 N곳」 이 부풀려진다.
/// 금액 · 업력 · 규모는 표기가 제각각이라 원문 글자로 둔다.
model MarketCompany {
  id                String   @id @default(uuid())
  name              String   @unique
  /// 이름 괄호에서 뗀 국가
  country           String?
  /// Global · Media & Culture gel · 오가노이드 회사 · Culture chip & dish · CRO
  segment           String?
  homepage          String?
  products          String?
  industry          String?
  ceo               String?
  foundedRaw        String?
  capitalRaw        String?
  revenueRaw        String?
  headcountRaw      String?
  /// 동물대체시험법
  animalAlternative Boolean?
  address           String?
  note              String?
  source            String   @default("notion")
  updatedAt         DateTime @updatedAt
}

enum RecordKind {
  /// 지원사업 (지원금 · 과제번호 · 자부담)
  GRANT
  /// 수상
  AWARD
  /// 학회 · 부스 · 전시
  EXHIBITION
  /// 포럼 · 세미나 참석/발표
  FORUM
  /// 교육 · 멘토링
  EDUCATION
  /// 네트워킹 · 방문
  NETWORKING
  /// 내부행사 · 입주 · 워크샵
  INTERNAL
  /// 그 밖의 주요 사건 (설립 · 인증 취득 …)
  MILESTONE
}

/// 회사 연혁 · 실적. 연혁 표가 상위 집합이고, 지원사업 · 수상 · 학회 시트는 상세 칸이 붙는 부분집합이다.
/// 날짜가 다르면 상세 시트가 정본 (2026-09-10 결정). 특허 · 상표는 ip 스키마가 정본이라 담지 않는다.
model CompanyRecord {
  id           String     @id @default(uuid())
  /// 이식 멱등 키 — kind · 제목 · 기관 · 시작일을 정규화해 만든다 (시작일이 비어도 겹치지 않게)
  dedupeKey    String     @unique
  kind         RecordKind
  title        String
  organizer    String?
  startsOn     DateTime?
  endsOn       DateTime?
  /// 원문 기간 표기. 화면엔 이것을 보여 준다 — 형식이 20종이라 파싱값만 두면 뜻이 상한다
  periodRaw    String?
  /// 완료 · 진행중 · 발표완료 · 계획
  status       String?
  note         String?
  subject      String?
  role         String?
  fundingKrw   BigInt?
  ownCashKrw   BigInt?
  ownInKindKrw BigInt?
  grantNo      String?
  prize        String?
  venue        String?
  /// 대리점 (EAS · 오리엔트바이오 · 준바이오텍). 비면 자사
  partner      String?
  /// 엑셀 원문 카테고리 (주요 · 내부행사 · 포럼 · 교육 · 네트워킹)
  category     String?
  /// 어느 표에서 왔나 — 연혁 · 지원사업 · 수상 · 학회 · 노션 · 옴니스
  source       String
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([kind, startsOn])
  @@index([startsOn])
}

enum TaxInvoiceDirection {
  SALE
  PURCHASE
}

/// 홈택스 전자세금계산서. 원본 PDF 는 NAS.
/// 매출 잠정치는 이 표의 공급가액 합으로 센다 (확정은 CompanyYear 의 결산서 값이 이긴다).
model TaxInvoice {
  id                 String              @id @default(uuid())
  approvalNo         String              @unique
  direction          TaxInvoiceDirection
  /// 일반 · 수정
  kind               String              @default("일반")
  originalApprovalNo String?
  issuedOn           DateTime
  supplierBizNo      String
  supplierName       String
  buyerBizNo         String
  buyerName          String
  supplyKrw          BigInt
  taxKrw             BigInt
  totalKrw           BigInt
  orgId              String?
  org                CrmOrg?             @relation(fields: [orgId], references: [id], onDelete: SetNull)
  quoteId            String?
  quote              CrmQuote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  objectKey          String
  fileName           String
  /// text(PDF 글자) · vision(AI 판독 — 사람이 확인해야 저장)
  readBy             String
  /// 검산 결과 { itemsSumMatches, totalMatches, problems[] }
  checks             Json
  uploadedById       String?
  createdAt          DateTime            @default(now())

  items TaxInvoiceItem[]

  @@index([issuedOn])
  @@index([orgId])
  @@index([direction, issuedOn])
}

model TaxInvoiceItem {
  id        String      @id @default(uuid())
  invoiceId String
  invoice   TaxInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo    Int
  name      String
  spec      String?
  quantity  Int?
  unitKrw   BigInt?
  supplyKrw BigInt
  taxKrw    BigInt
  /// 제품 · 용역
  category  String
  productId String?
  product   CrmProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}
